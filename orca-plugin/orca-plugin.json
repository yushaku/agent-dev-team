{
  "manifestVersion": 2,
  "id": "team-dashboard",
  "name": "Team dashboard",
  "version": "0.1.0",
  "description": "The team dashboard inside Orca (Overview, Tasks and Agents tools tabs), and the host of the agent history ledger.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "tasks",
        "title": "Team dashboard",
        "icon": "bar-chart-3",
        "entry": "dashboard-web/index.html",
        "ui": "html"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      },
      {
        "on": "workspace.created"
      },
      {
        "on": "workspace.removed"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "agent:read"
    },
    {
      "kind": "workspace:read"
    }
  ]
}
