{
  "manifestVersion": 2,
  "id": "team-dashboard",
  "name": "Team dashboard",
  "version": "0.1.0",
  "description": "The dashboard Tasks tab inside Orca.",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
