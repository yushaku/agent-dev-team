{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Review and fix rounds",
    "output": "diagrams/flow-review.html",
    "locale": "en",
    "quality_profile": "showcase",
    "legend": {
      "mode": "auto",
      "entries": {
        "frontend": {
          "label": "PO"
        },
        "cloud": {
          "label": "Orchestrator"
        },
        "backend": {
          "label": "Builder"
        },
        "external": {
          "label": "Reviewer"
        },
        "database": {
          "label": "Delivery"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "reviewer",
      "label": "Reviewer"
    },
    {
      "id": "orch",
      "label": "Orchestrator"
    },
    {
      "id": "builder",
      "label": "Builder"
    },
    {
      "id": "po",
      "label": "PO"
    }
  ],
  "phases": [
    {
      "id": "review",
      "label": "Review",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "fix",
      "label": "Fix round",
      "fromCol": 2,
      "toCol": 3
    },
    {
      "id": "recheck",
      "label": "Re-review",
      "fromCol": 4,
      "toCol": 5
    }
  ],
  "mainPath": [
    "review",
    "findings",
    "round",
    "repro",
    "fix",
    "rereview",
    "deliver"
  ],
  "nodes": [
    {
      "id": "review",
      "lane": "reviewer",
      "col": 0,
      "type": "external",
      "label": "code-review",
      "sublabel": "Standards + Spec, Anti-AI"
    },
    {
      "id": "findings",
      "lane": "reviewer",
      "col": 1,
      "type": "external",
      "label": "Findings",
      "sublabel": "Must fix, Should fix"
    },
    {
      "id": "round",
      "lane": "orch",
      "col": 1,
      "type": "cloud",
      "label": "Authorise round",
      "sublabel": "max 2"
    },
    {
      "id": "repro",
      "lane": "builder",
      "col": 2,
      "type": "backend",
      "label": "Reproduce or reject",
      "sublabel": "with evidence"
    },
    {
      "id": "fix",
      "lane": "builder",
      "col": 3,
      "type": "backend",
      "label": "Fix commits",
      "sublabel": "fixup into the commit"
    },
    {
      "id": "rereview",
      "lane": "reviewer",
      "col": 4,
      "type": "external",
      "label": "Scoped re-review",
      "sublabel": "prior findings + regressions"
    },
    {
      "id": "deliver",
      "lane": "orch",
      "col": 5,
      "type": "database",
      "label": "Deliver",
      "sublabel": "no Must fix left"
    },
    {
      "id": "po",
      "lane": "po",
      "col": 5,
      "type": "frontend",
      "label": "PO decides",
      "sublabel": "after 2 failed rounds",
      "tag": "PO decision"
    }
  ],
  "edges": [
    {
      "id": "review-findings",
      "from": "review",
      "to": "findings"
    },
    {
      "id": "findings-round",
      "from": "findings",
      "to": "round",
      "label": "blockers"
    },
    {
      "id": "round-repro",
      "from": "round",
      "to": "repro"
    },
    {
      "id": "repro-fix",
      "from": "repro",
      "to": "fix"
    },
    {
      "id": "fix-rereview",
      "from": "fix",
      "to": "rereview"
    },
    {
      "id": "rereview-deliver",
      "from": "rereview",
      "to": "deliver",
      "label": "pass"
    },
    {
      "id": "rereview-round",
      "from": "rereview",
      "to": "round",
      "label": "still failing",
      "role": "return"
    },
    {
      "id": "rereview-po",
      "from": "rereview",
      "to": "po",
      "label": "2 failed rounds",
      "role": "error"
    }
  ]
}
