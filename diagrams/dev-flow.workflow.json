{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Feature flow",
    "output": "diagrams/dev-flow.html",
    "locale": "en",
    "quality_profile": "showcase",
    "legend": {
      "mode": "auto",
      "entries": {
        "frontend": {
          "label": "PO"
        },
        "messagebus": {
          "label": "Plan"
        },
        "backend": {
          "label": "Builder"
        },
        "external": {
          "label": "Reviewer"
        },
        "database": {
          "label": "Delivery"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "po",
      "label": "PO"
    },
    {
      "id": "orch",
      "label": "Orchestrator"
    },
    {
      "id": "builder",
      "label": "Builder"
    },
    {
      "id": "reviewer",
      "label": "Reviewer"
    }
  ],
  "phases": [
    {
      "id": "plan",
      "label": "Grill, spec, tickets",
      "fromCol": 0,
      "toCol": 2
    },
    {
      "id": "build",
      "label": "Build + review",
      "fromCol": 3,
      "toCol": 4
    },
    {
      "id": "ship",
      "label": "Gate 2",
      "fromCol": 5,
      "toCol": 5
    }
  ],
  "mainPath": [
    "idea",
    "grill",
    "spec",
    "g1a",
    "tickets",
    "g1b",
    "build",
    "review",
    "deliver",
    "gate2",
    "close"
  ],
  "nodes": [
    {
      "id": "idea",
      "lane": "po",
      "col": 0,
      "type": "frontend",
      "label": "Idea",
      "sublabel": "PO asks Orchestrator"
    },
    {
      "id": "grill",
      "lane": "orch",
      "col": 0,
      "type": "messagebus",
      "label": "Grill",
      "sublabel": "grill-with-docs"
    },
    {
      "id": "spec",
      "lane": "orch",
      "col": 1,
      "type": "messagebus",
      "label": "Spec + seams",
      "sublabel": "to-spec"
    },
    {
      "id": "g1a",
      "lane": "po",
      "col": 1,
      "type": "frontend",
      "label": "Gate 1: spec",
      "sublabel": "PO confirms seams",
      "tag": "PO decision"
    },
    {
      "id": "tickets",
      "lane": "orch",
      "col": 2,
      "type": "messagebus",
      "label": "Tickets",
      "sublabel": "to-tickets, blockers"
    },
    {
      "id": "g1b",
      "lane": "po",
      "col": 2,
      "type": "frontend",
      "label": "Gate 1: tickets",
      "sublabel": "PO confirms slices",
      "tag": "PO decision"
    },
    {
      "id": "build",
      "lane": "builder",
      "col": 3,
      "type": "backend",
      "label": "Build tickets",
      "sublabel": "tdd, one Orca Task each"
    },
    {
      "id": "review",
      "lane": "reviewer",
      "col": 4,
      "type": "external",
      "label": "Review",
      "sublabel": "code-review, other agent"
    },
    {
      "id": "deliver",
      "lane": "orch",
      "col": 4,
      "type": "database",
      "label": "Deliver",
      "sublabel": "draft PR, app in DEV pane"
    },
    {
      "id": "gate2",
      "lane": "po",
      "col": 5,
      "type": "frontend",
      "label": "Gate 2",
      "sublabel": "PO tests in DEV pane",
      "tag": "PO decision"
    },
    {
      "id": "close",
      "lane": "orch",
      "col": 5,
      "type": "messagebus",
      "label": "Metrics, retro*",
      "sublabel": "then close the Run"
    }
  ],
  "edges": [
    {
      "id": "idea-grill",
      "from": "idea",
      "to": "grill",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "grill-spec",
      "from": "grill",
      "to": "spec"
    },
    {
      "id": "spec-g1a",
      "from": "spec",
      "to": "g1a"
    },
    {
      "id": "g1a-tickets",
      "from": "g1a",
      "to": "tickets",
      "label": "approved"
    },
    {
      "id": "tickets-g1b",
      "from": "tickets",
      "to": "g1b"
    },
    {
      "id": "g1b-build",
      "from": "g1b",
      "to": "build",
      "label": "approved"
    },
    {
      "id": "build-review",
      "from": "build",
      "to": "review"
    },
    {
      "id": "review-build",
      "from": "review",
      "to": "build",
      "label": "fix, max 2",
      "role": "return"
    },
    {
      "id": "review-deliver",
      "from": "review",
      "to": "deliver",
      "label": "no Must fix"
    },
    {
      "id": "deliver-gate2",
      "from": "deliver",
      "to": "gate2"
    },
    {
      "id": "gate2-close",
      "from": "gate2",
      "to": "close",
      "label": "approved"
    }
  ]
}
