{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "New capability flow",
    "output": "diagrams/dev-flow.html",
    "locale": "en",
    "quality_profile": "showcase",
    "legend": {
      "mode": "auto",
      "entries": {
        "frontend": {
          "label": "PO"
        },
        "cloud": {
          "label": "Orchestrator"
        },
        "messagebus": {
          "label": "Plan"
        },
        "backend": {
          "label": "Build"
        },
        "external": {
          "label": "Review"
        },
        "database": {
          "label": "Delivery"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "po",
      "label": "PO"
    },
    {
      "id": "orch",
      "label": "Orchestrator"
    },
    {
      "id": "builder",
      "label": "Builder"
    },
    {
      "id": "verify",
      "label": "Reviewer"
    },
    {
      "id": "delivery",
      "label": "Delivery"
    }
  ],
  "phases": [
    {
      "id": "plan",
      "label": "Grill, spec, tickets",
      "fromCol": 0,
      "toCol": 2
    },
    {
      "id": "proto",
      "label": "Prototype",
      "fromCol": 3,
      "toCol": 3
    },
    {
      "id": "build",
      "label": "Build + review",
      "fromCol": 4,
      "toCol": 4
    },
    {
      "id": "deliver",
      "label": "Deliver",
      "fromCol": 5,
      "toCol": 5
    }
  ],
  "mainPath": [
    "idea",
    "grill",
    "spec",
    "gate1a",
    "tickets",
    "gate1b",
    "build",
    "verify",
    "deliver",
    "gate2",
    "close"
  ],
  "nodes": [
    {
      "id": "idea",
      "lane": "po",
      "col": 0,
      "type": "frontend",
      "label": "Idea",
      "sublabel": "PO asks Orchestrator"
    },
    {
      "id": "grill",
      "lane": "orch",
      "col": 0,
      "type": "messagebus",
      "label": "Grill",
      "sublabel": "grill-with-docs, glossary, ADRs"
    },
    {
      "id": "spec",
      "lane": "orch",
      "col": 1,
      "type": "messagebus",
      "label": "Spec + seams",
      "sublabel": "to-spec"
    },
    {
      "id": "gate1a",
      "lane": "po",
      "col": 1,
      "type": "frontend",
      "label": "Gate 1: spec",
      "sublabel": "PO confirms seams",
      "tag": "PO decision"
    },
    {
      "id": "tickets",
      "lane": "orch",
      "col": 2,
      "type": "messagebus",
      "label": "Tickets",
      "sublabel": "to-tickets, blocking edges"
    },
    {
      "id": "gate1b",
      "lane": "po",
      "col": 2,
      "type": "frontend",
      "label": "Gate 1: tickets",
      "sublabel": "PO confirms slices",
      "tag": "PO decision"
    },
    {
      "id": "proto",
      "lane": "builder",
      "col": 3,
      "type": "backend",
      "label": "Prototype*",
      "sublabel": "only if the PO must see it"
    },
    {
      "id": "gui",
      "lane": "po",
      "col": 3,
      "type": "frontend",
      "label": "G-UI*",
      "sublabel": "PO picks a variant",
      "tag": "PO decision"
    },
    {
      "id": "build",
      "lane": "builder",
      "col": 4,
      "type": "backend",
      "label": "Build tickets",
      "sublabel": "tdd, one Orca Task each"
    },
    {
      "id": "verify",
      "lane": "verify",
      "col": 4,
      "type": "external",
      "label": "Review",
      "sublabel": "code-review, other agent"
    },
    {
      "id": "deliver",
      "lane": "delivery",
      "col": 5,
      "type": "database",
      "label": "Orchestrator delivers",
      "sublabel": "draft PR, app in DEV pane"
    },
    {
      "id": "gate2",
      "lane": "po",
      "col": 5,
      "type": "frontend",
      "label": "Gate 2",
      "sublabel": "PO tests in DEV pane",
      "tag": "PO decision"
    },
    {
      "id": "close",
      "lane": "orch",
      "col": 5,
      "type": "messagebus",
      "label": "Metrics, retro*",
      "sublabel": "retro only if the Run had problems"
    }
  ],
  "edges": [
    {
      "id": "ask",
      "from": "idea",
      "to": "grill",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "grill-spec",
      "from": "grill",
      "to": "spec"
    },
    {
      "id": "spec-gate",
      "from": "spec",
      "to": "gate1a"
    },
    {
      "id": "gate-tickets",
      "from": "gate1a",
      "to": "tickets",
      "label": "approved"
    },
    {
      "id": "tickets-gate",
      "from": "tickets",
      "to": "gate1b"
    },
    {
      "id": "gate-proto",
      "from": "gate1b",
      "to": "proto",
      "label": "UI to see*"
    },
    {
      "id": "proto-gui",
      "from": "proto",
      "to": "gui"
    },
    {
      "id": "gui-build",
      "from": "gui",
      "to": "build",
      "label": "chosen variant"
    },
    {
      "id": "gate-build",
      "from": "gate1b",
      "to": "build",
      "label": "approved"
    },
    {
      "id": "build-verify",
      "from": "build",
      "to": "verify"
    },
    {
      "id": "fix-loop",
      "from": "verify",
      "to": "build",
      "label": "fix + re-review, max 2",
      "variant": "default",
      "role": "return"
    },
    {
      "id": "verify-deliver",
      "from": "verify",
      "to": "deliver",
      "label": "green"
    },
    {
      "id": "deliver-gate",
      "from": "deliver",
      "to": "gate2"
    },
    {
      "id": "gate-close",
      "from": "gate2",
      "to": "close",
      "label": "approved"
    }
  ]
}
