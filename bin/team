#!/usr/bin/env bash
# team: mechanical Orchestrator steps (Run, worktree, Task spec, Task, Dispatch, status).
# Run it from the Orchestrator's own Orca terminal or chat: Orca binds Runs and receives
# worker_done through the caller's runtime environment. Judgment (spec text, model choice,
# reading reports, gates) stays with the Orchestrator. See `team help`.
set -euo pipefail

ORCA=${TEAM_ORCA_BIN:-orca}
ORCA_ENV=${TEAM_ORCA_ENV:-local}
SKILLS_DIR=${AGENT_SKILLS_DIR:-$HOME/.agents/skills}
FILL="FILL:"
SKELETON="<!-- team skeleton"
TEAM_BIN="$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")"
ROLES="builder|reviewer|support-engineer"
SENIOR="senior-backend|senior-frontend"  # PO-invoked roles that work their own Task (team solo)

# Bash clears set -e inside $(...). Functions that run there start with `set -e` again, so a refusal
# deep inside (say a spec check under `start`) stops the step instead of creating the Task anyway.
die() { echo "team: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "missing command: $1"; }

usage() {
  cat <<'EOF'
Usage: team <command> [feature] [args]

[feature] may be omitted after init: team picks the feature whose workspace is the current
checkout, else the only feature in .team/, else $TEAM_FEATURE.

  init <feature> --objective TEXT [--branch B] [--base REF] [--here]
      Worktree (or current checkout with --here), .team and worktree_links links, feature dirs,
      Orca Run, run.json, handoff.md skeleton, board in-progress. Rerun reuses run.json.
  spec [feature] <role> [spec flags]
      Write specs/NN-<role>[-rN|-NAME].md. Lines left as FILL: are for the Orchestrator.
  task [feature] <spec> [--title TEXT] [--deps ID,ID]
      Validate the spec and create the Orca Task. Title defaults to the ticket name or Goal.
  dispatch [feature] <task-id|spec> [--terminal H | --reuse ROLE | --catalog A] [--same-agent-ok]
      worker-start --keep-open on the feature workspace, or on a kept terminal; append
      routing.jsonl; record the Dispatch in run.json. --catalog retries on another entry of the
      spec's tier (a launch or account failure); stop the failed Dispatch first.
  start [feature] <spec|role> [spec flags] [task flags] [dispatch flags]
      With a role: spec + task + dispatch in one step (spec removed if the Task is refused).
  review [feature] --catalog A [--tier T] [--read-as V] [--selection T] [--same-agent-ok] [--constraint|--ref|--skill X]...
      After an "implemented" build: the review of base..HEAD on a new Reviewer (catalog is the
      Orchestrator's routing choice), the Builder's ticket and report as Ref; records the build
      as processed in handoff.md.
  fix [feature] [--cause C] [--round N] [--read-as V] [--selection T] [--constraint|--ref|--skill X]...
      After a "changes requested" review: fix round N (review round + 1) on the same Builder,
      same ticket, the review report as Ref; records the review as processed in handoff.md.
      A third round is refused until the PO approves it (then pass --round 3). A report verdict
      worded otherwise is refused unless --read-as "changes requested" (rereview: "implemented").
  rereview [feature] [--read-as V] [--selection T] [--constraint|--ref|--skill X]...
      After a fix round: scoped re-review of round N on the same Reviewer, with the prior review
      and the fix report as Refs; records the fix as processed in handoff.md.
  accept [feature] [--read-as V]
      After a "pass" review: run commands.verify in the workspace (log in logs/), record the
      review as processed, set handoff Stage to Gate 2 pending and the board to in-review.
  status [feature] [--json]
      Orca Task status joined with Dispatch, report path and report verdict; warns about finished
      reports without a Processed line in handoff.md and a handoff over 40 lines.
  board [feature] <todo|in-progress|in-review|completed>
  read [feature] <task-id|role> [--last N]
      Last N transcript messages (default 5) of that Task's or role's latest Dispatch.
  close [feature] [--merge] [--remove-worktree [--delete-branch]]
      After the PO accepts delivery: --merge makes a merge commit (--no-ff) of the feature branch
      on the base branch in the main checkout and runs commands.verify there; then release every
      recorded worker, board completed and, when asked, remove the feature worktree. Refused with
      uncommitted changes, from inside the worktree, on a merge conflict (merge aborted) or a
      failed verify (merge kept, nothing closed).
  retry [feature] <task-id|role> --reason TEXT [--catalog A] [--same-agent-ok]
      A worker that failed to run (launch, account, balance, crash): stop its Dispatch, set the
      Task ready and dispatch again on catalog entry A of the spec's tier (default: the failed
      Dispatch's entry); records
      the reason in handoff.md. Refused for a completed Task.
  pr-preflight [feature] <target> [--remote R]
      Before a PR from a long-lived branch: fetch, outgoing commits by author, other-author commits
      on no remote branch and not in target (ask the PO), wip commits with their live lines.
  verify [feature] [--reuse]
      Worker side: commands.verify in the workspace, logged as logs/verify-<sha>.log with the result
      per command (serial: true waits for other verifies). --reuse keeps a green log at the same
      clean HEAD. Uncommitted changes log as -dirty and do not count for submit.
  solo <feature> --role senior-backend|senior-frontend --goal TEXT [--scope TEXT] [--branch B]
       [--base REF] [--worktree]
      PO-invoked senior session working its own Task: init (current checkout, switched off the
      base branch to B, default feat/<feature>; --worktree for a new one), spec, Orca Task,
      Dispatch to this terminal (dashboard: in progress), prefilled report. Rerun resumes the
      role's open Task.
  submit <report> [--summary <text>] [--check] [--from <orca_session_id:...>]
      Worker side: check the prefilled report (FILL lines, verdict word first, Evidence, Reviewer
      Standards/Spec, Builder "implemented" on a clean tree, a green team verify log at HEAD for
      implemented and pass), record Revision, then send worker_done
      (outcome failed only for blocked/failed). --check validates without sending.
      Senior roles: builder checks, then the Task is set completed (implemented) or failed
      (failed); partial and blocked keep it in progress for the next team solo. The report is
      recorded as processed in handoff.md.
  agents [--json | --check]
      Orca agents on this host: CLI, launch flags Orca passes, own default model, the models each
      lists (read-only local sources). --check validates .team/config.yaml models against them.
  whoami
      This session's Orca identity (terminal handle, Orca session, agent), as init records it.

Spec flags:
  --catalog ALIAS   models.catalog entry; tier comes from models.tiers (--tier when ambiguous)
  --tier T          fast|work|top; must contain ALIAS
  --selection TEXT  why this tier and entry (Selection:)
  --ticket PATH     ticket file; replaces Goal and Scope
  --goal TEXT --scope TEXT   for Tasks without a ticket
  --kind K --round N --cause C   Measurement (fix/re-review need --round)
  --reuse ROLE      continue on that role's last worker: copy its Routing, dispatch to its terminal
  --name SUFFIX     file name suffix
  --constraint TEXT, --skill PATH, --ref TEXT   (repeatable) added to Constraints, Skills, Refs.
                    Constraints already carry worker communication, browser, matt.*, human_only
                    and the codegraph rule from config.
  --same-agent-ok   allow a Reviewer on a Builder's agent (PO exception, routing.md rule 4)

Call it as `team ...` or by path, never through a shell variable: the dashboard links the
session to the Run from the command line plus the JSON marker team prints on stderr.
Env: TEAM_FEATURE, TEAM_ORCA_BIN (orca), TEAM_ORCA_ENV (local), AGENT_SKILLS_DIR.
EOF
}

# ---------- helpers ----------

main_checkout() {
  local common
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || die "not inside a git repo"
  dirname "$common"
}

feature_dir() { echo "$(main_checkout)/.team/$1"; }
state_file() { echo "$(feature_dir "$1")/run.json"; }
real() { (cd "$1" 2>/dev/null && pwd -P) || echo "$1"; }

load_state() {
  set -e
  local f; f=$(state_file "$1")
  [ -f "$f" ] || die "no $f; run: team init $1 --objective ..."
  cat "$f"
}

save_state() { # feature json
  local f tmp; f=$(state_file "$1"); tmp="$f.tmp.$$"
  printf '%s\n' "$2" | jq . >"$tmp" && mv "$tmp" "$f"
}

features() { local f; for f in "$(main_checkout)"/.team/*/run.json; do [ -f "$f" ] && basename "$(dirname "$f")"; done; return 0; }

infer_feature() {
  set -e
  [ -n "${TEAM_FEATURE:-}" ] && { echo "$TEAM_FEATURE"; return; }
  local top all f hits=() n
  top=$(real "$(git rev-parse --show-toplevel)"); all=$(features)
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    [ "$(real "$(jq -r .workspace.path "$(state_file "$f")")")" = "$top" ] && hits+=("$f")
  done <<<"$all"
  [ ${#hits[@]} = 1 ] && { echo "${hits[0]}"; return; }
  n=$(grep -c . <<<"$all" || true)
  [ ${#hits[@]} = 0 ] && [ "$n" = 1 ] && { echo "$all"; return; }
  die "which feature? pass it as the first argument or set TEAM_FEATURE (features: $(echo $all | tr ' ' ',' ))"
}

# orca_call <args...>: run orca with --json, print .result, fail with the full receipt.
orca_call() {
  set -e
  local out
  if ! out=$("$ORCA" "$@" --environment "$ORCA_ENV" --json 2>&1); then
    echo "$out" >&2; die "orca $1 $2 failed (see receipt above; recover per the orchestration guide, do not blindly rerun)"
  fi
  if ! printf '%s' "$out" | jq -e '.ok == true' >/dev/null 2>&1; then
    echo "$out" >&2; die "orca $1 $2 returned no ok receipt"
  fi
  printf '%s' "$out" | jq -c '.result'
}

config_file() { echo "$(main_checkout)/.team/config.yaml"; }

# YAML subset used by .team/config.yaml: block maps and lists, "- key: v" list items, flow [..] and
# {..}, quoted/plain scalars, comments. Anchors, multi-docs and block scalars (| >) are not supported.
read -r -d '' YAML_JS <<'JS' || true
const src = require('fs').readFileSync(process.argv[1], 'utf8');
const strip = (l) => { let q = ''; for (let i = 0; i < l.length; i++) { const c = l[i];
  if (q) { if (c === q) q = ''; } else if (c === '"' || c === "'") q = c;
  else if (c === '#' && (i === 0 || /\s/.test(l[i - 1]))) return l.slice(0, i); } return l; };
const lines = src.split(/\r?\n/).map((l, n) => ({ n: n + 1, raw: strip(l).replace(/\s+$/, '') }))
  .filter((l) => l.raw.trim() && l.raw.trim() !== '---')
  .map((l) => { if (/^\s*\t/.test(l.raw)) throw new Error('line ' + l.n + ': tab indentation');
    return { n: l.n, ind: l.raw.match(/^ */)[0].length, t: l.raw.trim() }; });
const keyAt = (t) => { let q = ''; for (let i = 0; i < t.length; i++) { const c = t[i];
  if (q) { if (c === q) q = ''; continue; } if (c === '"' || c === "'") { q = c; continue; }
  if (c === ':' && (i === t.length - 1 || t[i + 1] === ' ')) return i; } return -1; };
const split = (s) => { const out = []; let d = 0, q = '', cur = '';
  for (const c of s) { if (q) { cur += c; if (c === q) q = ''; continue; }
    if (c === '"' || c === "'") q = c; else if ('[{'.includes(c)) d++; else if (']}'.includes(c)) d--;
    else if (c === ',' && d === 0) { out.push(cur); cur = ''; continue; } cur += c; }
  if (cur.trim()) out.push(cur); return out; };
const unq = (s) => s.trim().replace(/^(["'])(.*)\1$/, '$2');
const scalar = (s) => { s = s.trim();
  if (s.startsWith('[') && s.endsWith(']')) return split(s.slice(1, -1)).map(scalar);
  if (s.startsWith('{') && s.endsWith('}')) { const o = {};
    for (const p of split(s.slice(1, -1))) { const k = keyAt(p.trim());
      if (k < 0) throw new Error('bad flow map entry: ' + p); o[unq(p.trim().slice(0, k))] = scalar(p.trim().slice(k + 1)); }
    return o; }
  if (/^(".*"|'.*')$/.test(s)) return s.slice(1, -1);
  if (s === '' || s === 'null' || s === '~') return null;
  if (s === 'true' || s === 'false') return s === 'true';
  if (/^-?\d+(\.\d+)?$/.test(s)) return Number(s);
  if (/^[|>&*!]/.test(s)) throw new Error('unsupported YAML: ' + s);
  return s; };
let i = 0;
const item = (t) => t === '-' || t.startsWith('- ');
const block = (ind) => {
  if (item(lines[i].t)) { const arr = [];
    while (i < lines.length && lines[i].ind === ind && item(lines[i].t)) {
      const rest = lines[i].t.slice(1).trim();
      if (!rest) { i++; arr.push(i < lines.length && lines[i].ind > ind ? block(lines[i].ind) : null); }
      else if (keyAt(rest) > 0 && !/^["'[{]/.test(rest)) { lines[i] = { ...lines[i], ind: ind + 2, t: rest }; arr.push(block(ind + 2)); }
      else { arr.push(scalar(rest)); i++; } }
    return arr; }
  const obj = {};
  while (i < lines.length && lines[i].ind === ind && !item(lines[i].t)) {
    const { t, n } = lines[i], k = keyAt(t);
    if (k < 0) throw new Error('line ' + n + ': expected "key: value"');
    const v = t.slice(k + 1).trim(); i++;
    obj[unq(t.slice(0, k))] = v ? scalar(v)
      : i < lines.length && (lines[i].ind > ind || (lines[i].ind === ind && item(lines[i].t))) ? block(lines[i].ind) : null; }
  if (i < lines.length && lines[i].ind > ind) throw new Error('line ' + lines[i].n + ': unexpected indentation');
  return obj; };
const out = lines.length ? block(lines[0].ind) : {};
if (i < lines.length) throw new Error('line ' + lines[i].n + ': unexpected indentation');
process.stdout.write(JSON.stringify(out));
JS

CFG='{}'
read -r -d '' AGENTS_JS <<'JS' || true
// team agents: what each Orca agent on this host can launch, from read-only local sources.
// argv: mode (table|json|check). env: TEAM_ORCA, TEAM_ORCA_ENV, TEAM_CFG (config JSON, check mode).
const { spawnSync } = require('node:child_process');
const fs = require('node:fs'), os = require('node:os'), path = require('node:path');
const home = os.homedir();
const run = (cmd, args, ms = 30000) => {
  const r = spawnSync(cmd, args, { encoding: 'utf8', timeout: ms, maxBuffer: 32 << 20 });
  return r.status === 0 ? r.stdout : null;
};
const which = (c) => (run('/bin/sh', ['-c', 'command -v ' + c]) || '').trim() || null;
const json = (p) => { try { return JSON.parse(fs.readFileSync(p, 'utf8')); } catch { return null; } };
const text = (p) => { try { return fs.readFileSync(p, 'utf8'); } catch { return ''; } };
const PI_LEVELS = ['off', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max'];

// Per agent: models it can be launched with, the flags Orca passes (worker-start --help), its own default.
const probes = {
  claude(cli) {
    const help = run(cli, ['--help']) || '';
    const efforts = ((help.match(/--effort[\s\S]*?\(([^)]*)\)/) || [])[1] || '').split(/,\s*/).filter(Boolean);
    const block = (help.match(/--model <model>[\s\S]*?(?=\n\s{2}-)/) || [''])[0];
    // Documented aliases (latest release of each family) plus the examples --help names.
    const aliases = [...new Set(['haiku', 'sonnet', 'opus', ...[...block.matchAll(/'([a-z0-9.-]+)'/g)].map((m) => m[1])])];
    const s = json(path.join(process.env.CLAUDE_CONFIG_DIR || path.join(home, '.claude'), 'settings.json')) || {};
    return {
      launch: { model: true, effort: efforts },
      models: aliases.map((id) => ({ id, efforts })),
      modelsComplete: false,
      default: { model: s.model || null, effort: s.effortLevel || null },
      source: 'claude --help (aliases), ~/.claude/settings.json',
      notes: 'Full model names work too. Orca refuses an effort the model lacks: haiku takes none.',
    };
  },
  codex() {
    const cache = json(path.join(home, '.codex/models_cache.json')) || { models: [] };
    const models = cache.models.filter((m) => m.visibility === 'list').map((m) => ({
      id: m.slug,
      efforts: (m.supported_reasoning_levels || []).map((l) => (typeof l === 'string' ? l : l.effort)).filter(Boolean),
    }));
    const t = text(path.join(home, '.codex/config.toml'));
    const get = (k) => ((t.match(new RegExp('^' + k + '\\s*=\\s*"([^"]*)"', 'm')) || [])[1]) || null;
    return {
      launch: { model: true, effort: [...new Set(models.flatMap((m) => m.efforts))] },
      models, modelsComplete: models.length > 0,
      default: { model: get('model'), effort: get('model_reasoning_effort') },
      source: '~/.codex/models_cache.json, ~/.codex/config.toml',
    };
  },
  pi(cli) {
    const out = run(cli, ['--list-models']) || '';
    const models = out.split('\n').slice(1).map((l) => l.trim().split(/\s+/)).filter((c) => c.length >= 5)
      .map((c) => ({ id: c[0] + '/' + c[1], efforts: c[4] === 'yes' ? PI_LEVELS : [] }));
    const s = json(path.join(home, '.pi/agent/settings.json')) || {};
    return {
      launch: { model: true, effort: PI_LEVELS },
      models, modelsComplete: models.length > 0,
      default: { model: s.defaultProvider && s.defaultModel ? s.defaultProvider + '/' + s.defaultModel : null, effort: s.defaultThinkingLevel || null },
      source: 'pi --list-models, ~/.pi/agent/settings.json',
      notes: 'Model is provider/id; Orca maps effort to the thinking level.',
    };
  },
  opencode(cli) {
    const out = run(cli, ['models'], 60000) || '';
    const models = out.split('\n').map((l) => l.trim()).filter((l) => /^[\w.-]+\/\S+$/.test(l)).map((id) => ({ id, efforts: [] }));
    return {
      launch: { model: true, effort: null },
      models, modelsComplete: models.length > 0, default: { model: null, effort: null },
      source: 'opencode models',
      notes: 'Orca: model selection needs an existing worktree; effort unsupported.',
    };
  },
  hermes() {
    const t = text(path.join(home, '.hermes/config.yaml'));
    const m = t.match(/^model:\n((?:[ \t]+.*\n)+)/m);
    const get = (k) => (m && (m[1].match(new RegExp('^\\s+' + k + ':\\s*(\\S+)', 'm')) || [])[1]) || null;
    return {
      launch: { model: false, effort: null }, models: [], modelsComplete: false,
      default: { model: get('provider') && get('default') ? get('provider') + '/' + get('default') : get('default'), effort: null },
      source: '~/.hermes/config.yaml',
      notes: 'Orca launches it with the model from its own config: catalog model and effort must be null.',
    };
  },
};
const other = () => ({
  launch: { model: false, effort: null }, models: [], modelsComplete: false, default: { model: null, effort: null },
  source: null, notes: 'No probe: Orca launches it with its own config; use model and effort null.',
});

function inventory() {
  const orca = process.env.TEAM_ORCA || 'orca';
  const out = run(orca, ['agent', 'installed', '--json', '--environment', process.env.TEAM_ORCA_ENV || 'local']);
  if (!out) throw Error(orca + ' agent installed failed');
  return JSON.parse(out).result.agents.map((a) => {
    const cli = which(a.id);
    const probe = probes[a.id] && cli ? probes[a.id](cli) : other();
    return { id: a.id, name: a.name, orcaDefault: !!a.default, cli, ...probe };
  });
}

function check(agents, cfg) {
  const errors = [], warnings = [];
  const byId = Object.fromEntries(agents.map((a) => [a.id, a]));
  const m = cfg.models || {}, catalog = m.catalog || {}, tiers = m.tiers || {};
  if (!Object.keys(catalog).length) errors.push('models.catalog is empty');
  for (const [alias, e] of Object.entries(catalog)) {
    if (!e || typeof e !== 'object') { errors.push(`${alias}: not a map`); continue; }
    const a = byId[e.agent], at = `catalog.${alias}`;
    if (!e.agent) { errors.push(`${at}: agent missing`); continue; }
    if (!a) { (e.enabled === false ? warnings : errors).push(`${at}: agent ${e.agent} is not installed for Orca (installed: ${agents.map((x) => x.id).join(', ')})`); continue; }
    if (e.enabled === false) continue;
    if (e.model != null && !a.launch.model) errors.push(`${at}: Orca ignores --model for ${a.id}; use model: null`);
    if (e.effort != null && a.launch.effort === null) errors.push(`${at}: ${a.id} takes no effort; use effort: null`);
    if (e.effort != null && e.model == null) errors.push(`${at}: Orca needs --model with --effort; set model or effort: null`);
    const known = a.models.find((x) => x.id === e.model);
    if (e.model != null && a.launch.model && !known && a.modelsComplete) errors.push(`${at}: model ${e.model} is not in ${a.source.split(',')[0]}`);
    if (e.model != null && a.launch.model && !known && !a.modelsComplete) warnings.push(`${at}: model ${e.model} not listed by ${a.id}; check it launches`);
    if (e.effort != null && known && known.efforts.length && !known.efforts.includes(e.effort)) errors.push(`${at}: ${e.model} supports effort ${known.efforts.join('|')}, not ${e.effort}`);
    if (e.effort != null && known && !known.efforts.length && a.launch.effort) errors.push(`${at}: ${e.model} lists no effort levels; use effort: null`);
    if (a.id === 'claude' && /haiku/.test(e.model || '') && e.effort != null) errors.push(`${at}: Orca refuses an effort for haiku; use effort: null`);
  }
  const live = (alias) => catalog[alias] && catalog[alias].enabled !== false && byId[catalog[alias].agent];
  for (const t of ['fast', 'work', 'top']) if (!tiers[t]) warnings.push(`tiers.${t} is missing`);
  for (const [t, list] of Object.entries(tiers)) {
    if (!['fast', 'work', 'top'].includes(t)) errors.push(`tiers.${t}: tier names are fast, work, top`);
    for (const alias of list || []) if (!catalog[alias]) errors.push(`tiers.${t}: ${alias} is not in catalog`);
    const agentsIn = [...new Set((list || []).filter(live).map((x) => catalog[x].agent))];
    if (!agentsIn.length) errors.push(`tiers.${t}: no enabled, installed entry`);
    else if (agentsIn.length === 1) warnings.push(`tiers.${t}: one agent (${agentsIn[0]}); a rate limit blocks the tier`);
  }
  const first = (t) => (tiers[t] || []).filter(live).map((x) => catalog[x].agent);
  const builder = first('work')[0];
  if (builder && first('top').length && first('top').every((a) => a === builder))
    warnings.push(`tiers.top: only ${builder}, the work tier's first agent; the Reviewer needs another agent (PO exception otherwise)`);
  for (const [role, r] of Object.entries(m.roles || {})) {
    if (!['builder', 'reviewer', 'support-engineer'].includes(role)) errors.push(`roles.${role}: roles are builder, reviewer, support-engineer`);
    for (const alias of (r && r.prefer) || []) {
      const t = r.tier;
      if (!catalog[alias]) errors.push(`roles.${role}: ${alias} is not in catalog`);
      else if (t && !(tiers[t] || []).includes(alias)) errors.push(`roles.${role}: ${alias} is not in tier ${t}`);
    }
  }
  return { errors, warnings };
}

const mode = process.argv[1] || 'table'; // node -e: argv[1] is the first argument
const agents = inventory();
if (mode === 'json') { console.log(JSON.stringify({ agents }, null, 2)); process.exit(0); }
if (mode === 'check') {
  const { errors, warnings } = check(agents, JSON.parse(process.env.TEAM_CFG || '{}'));
  for (const w of warnings) console.log('warn:  ' + w);
  for (const e of errors) console.log('error: ' + e);
  console.log(errors.length ? `models: ${errors.length} error(s)` : 'models: ok' + (warnings.length ? ` (${warnings.length} warning(s))` : ''));
  process.exit(errors.length ? 1 : 0);
}
const fx = (l) => (l === null ? 'none' : l.length ? l.join('|') : 'none');
for (const a of agents) {
  console.log(`${a.id}${a.orcaDefault ? ' (Orca default)' : ''}: ${a.cli || 'no CLI on PATH'}`);
  console.log(`  launch: --model ${a.launch.model ? 'yes' : 'no'}, --effort ${a.launch.model ? fx(a.launch.effort) : 'no'}`);
  console.log(`  own default: ${a.default.model || '-'}${a.default.effort ? ' / ' + a.default.effort : ''}`);
  if (a.models.length) {
    const groups = {};
    for (const m of a.models) { const p = m.id.includes('/') ? m.id.split('/')[0] : ''; (groups[p] = groups[p] || []).push(m.id.slice(p ? p.length + 1 : 0)); }
    for (const [p, ids] of Object.entries(groups))
      console.log(`  models${p ? ' ' + p + '/' : ''} (${ids.length}): ${ids.slice(0, 12).join(', ')}${ids.length > 12 ? ', ...' : ''}`);
  }
  if (a.notes) console.log('  note: ' + a.notes);
  if (a.source) console.log('  source: ' + a.source);
}
console.log('Full lists and per-model effort levels: team agents --json');
JS

cmd_agents() {
  local mode=table
  case "${1:-}" in "") ;; --json) mode=json;; --check) mode=check;; *) die "agents: unknown $1";; esac
  if [ $mode = check ]; then
    git rev-parse --git-dir >/dev/null 2>&1 || die "agents --check: run inside the repo"
    load_cfg; [ -n "${CFG:-}" ] || die "agents --check: no $(config_file)"
  fi
  TEAM_ORCA="$ORCA" TEAM_ORCA_ENV="$ORCA_ENV" TEAM_CFG="${CFG:-}" node -e "$AGENTS_JS" "$mode"
}

load_cfg() {
  local f err; f=$(config_file); [ -f "$f" ] || return 0
  CFG=$(node -e "$YAML_JS" "$f" 2>&1) || {
    err=$(grep -m1 -E '^(Error|SyntaxError)' <<<"$CFG" || echo "$CFG" | tail -1)
    die "cannot read $f: $err (team reads a YAML subset: maps, lists, [..], {..}, scalars)"; }
}
cfg() { jq -r "$@" <<<"$CFG"; }

# mark <cmd> <run> [key value]...: one-line marker on stderr; the dashboard ledger reads it from the
# coordinator's tool output to attach the session to the Run (orca-plugin/ledger/session.ts teamRuns).
mark() {
  local args=(--arg team "$1" --arg run "$2") expr='{team:$team, run:$run'; shift 2
  while [ $# -gt 1 ]; do args+=(--arg "$1" "$2"); expr="$expr, $1:\$$1"; shift 2; done
  jq -nc "${args[@]}" "$expr}" >&2
}

spec_line() { sed -nE "s/^$2:[[:space:]]*//p" "$1" | head -1; }

abs_path() { (cd "$(dirname "$1")" && echo "$PWD/$(basename "$1")"); }

link_into() { # src dest: symlink dest -> src unless dest exists
  local src=$1 dest=$2
  [ -e "$dest" ] || [ -L "$dest" ] && return 0
  [ -e "$src" ] || { echo "team: skip link, missing $src" >&2; return 0; }
  mkdir -p "$(dirname "$dest")"; ln -s "$src" "$dest"
}

# exclude_links <worktree>: hide the links init makes from git status. A ".team/" ignore line matches a
# directory, not the symlink, and an untracked link would block `git worktree remove`.
exclude_links() {
  local w=$1 ex l; ex="$(git -C "$w" rev-parse --path-format=absolute --git-common-dir)/info/exclude"
  for l in .team $(cfg '.worktree_links // [] | .[]'); do
    [ -L "$w/$l" ] || continue
    git -C "$w" check-ignore -q "$l" 2>/dev/null && continue
    mkdir -p "$(dirname "$ex")"; echo "/$l" >>"$ex"
  done
}

# claude_write_check <main>: warn when Claude Code's sandbox would refuse worker writes to <main>/.team
# (reports, logs). Its writes are limited to the worktree and sandbox.filesystem.allowWrite, and the
# worktree's .team is a link out of it. Granting it is the PO's call, so team only says what to add.
claude_write_check() {
  local s="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json" dir; dir="$(real "$1")/.team"
  [ -f "$s" ] || return 0
  jq -e --arg d "$dir" --arg h "$HOME" '.sandbox.enabled == true and
      ([.sandbox.filesystem.allowWrite[]? | sub("^~"; $h) | sub("/+$"; "")]
       | any(. as $p | $d == $p or ($d | startswith($p + "/"))) | not)' "$s" >/dev/null 2>&1 || return 0
  echo "team: Claude workers cannot write $dir (Claude sandbox). With PO approval add it to sandbox.filesystem.allowWrite and permissions.additionalDirectories in $s; see start.md \"Worker permissions\"." >&2
}

# routing_for <role> <alias> <tier>: Routing JSON with the tier taken from models.tiers.
routing_for() {
  set -e
  local role=$1 alias=$2 tier=$3 entry tiers count
  entry=$(cfg -c --arg a "$alias" '.models.catalog[$a] // empty')
  [ -n "$entry" ] || die "spec: catalog alias $alias not in models.catalog of $(config_file) (aliases: $(cfg '.models.catalog // {} | keys | join(", ")'))"
  [ "$(jq -r 'if type=="object" then .agent // empty else empty end' <<<"$entry")" != "" ] \
    || die "spec: models.catalog.$alias has no agent"
  [ "$(jq -r '.enabled' <<<"$entry")" = false ] && die "spec: models.catalog.$alias is disabled (enabled: false)"
  tiers=$(cfg --arg a "$alias" '.models.tiers // {} | to_entries[] | select(.value | type=="array" and index($a)) | .key')
  count=$(grep -c . <<<"$tiers" || true)
  if [ "$(cfg '.models.tiers // {} | length')" = 0 ]; then
    [ -n "$tier" ] || tier=$(cfg --arg r "$role" '.models.roles[$r].tier // "work"')
  elif [ -n "$tier" ]; then
    grep -qx "$tier" <<<"$tiers" || die "spec: $alias is not in tier $tier (models.tiers puts it in: ${tiers:-none})"
  elif [ "$count" = 1 ]; then tier=$tiers
  elif [ "$count" = 0 ]; then die "spec: $alias is in no models.tiers entry; add it there or pass --tier"
  else die "spec: $alias is in tiers $(echo $tiers | tr ' ' ','); pass --tier"; fi
  case $tier in fast|work|top) ;; *) die "spec: bad tier $tier (fast|work|top)";; esac
  jq -c --arg t "$tier" --arg a "$alias" '{tier:$t, catalog:$a, agent:.agent, model:(.model // null), effort:(.effort // null)}' <<<"$entry"
}

check_independent() { # state role agent same_ok: Reviewer must not run on a Builder's agent
  [ "$2" = reviewer ] && [ "$4" = 0 ] && [ -n "$3" ] || return 0
  local clash; clash=$(jq -r --arg a "$3" \
    '[.tasks[] | select(.role=="builder") | .dispatches[] | select(.agent==$a)] | length' <<<"$1")
  [ "$clash" = 0 ] || die "Reviewer agent $3 equals a Builder agent (routing.md rule 4); use another catalog entry or --same-agent-ok after the PO agrees"
}

last_of_role() { # state role -> task id of the role's latest Task with a Dispatch
  jq -r --arg r "$2" '[.tasks | to_entries[] | select(.value.role==$r and (.value.dispatches|length)>0) | .key] | last // empty' <<<"$1"
}

# ---------- commands ----------

cmd_init() {
  local feature=${1:-}; [ -n "$feature" ] && [ "${feature#-}" = "$feature" ] || die "init: feature name required"; shift
  local objective="" branch="" base="" here=0
  while [ $# -gt 0 ]; do case $1 in
    --objective) objective=$2; shift 2;; --branch) branch=$2; shift 2;;
    --base) base=$2; shift 2;; --here) here=1; shift;; *) die "init: unknown $1";; esac; done
  [ -n "$objective" ] || die "init: --objective required"

  local main fdir state; main=$(main_checkout); fdir="$main/.team/$feature"; state="$fdir/run.json"
  if [ -f "$state" ]; then
    echo "team: reusing $state" >&2; mark init "$(jq -r .run "$state")"
    [ "$(cfg '[.models.catalog // {} | .[] | select(type=="object" and .agent=="claude" and .enabled != false)] | length')" = 0 ] \
      || claude_write_check "$main"
    jq . "$state"; return 0
  fi
  [ -n "$base" ] || base=$(cfg '.branches.base // "main"')
  [ -n "$branch" ] || branch="feat/$feature"

  local wpath wsel wbranch
  if [ $here = 1 ]; then
    wpath=$(git rev-parse --show-toplevel)
  else
    local wt
    wt=$(orca_call worktree create --repo "path:$main" --name "$feature" --branch "$branch" --base-branch "$base")
    wpath=$(printf '%s' "$wt" | jq -r '.worktree.path // .path // empty')
    [ -n "$wpath" ] || { echo "$wt" >&2; die "init: worktree receipt has no path"; }
  fi
  wbranch=$(git -C "$wpath" rev-parse --abbrev-ref HEAD)
  wsel="path:$wpath"

  mkdir -p "$fdir"/{specs,reports,logs,issues,inputs}
  if [ "$wpath" != "$main" ]; then
    link_into "$main/.team" "$wpath/.team"
    local l; while IFS= read -r l; do [ -n "$l" ] && link_into "$main/$l" "$wpath/$l"; done < <(cfg '.worktree_links // [] | .[]')
    exclude_links "$wpath"
  fi

  local run run_id
  run=$(orca_call orchestration run-create --objective "$objective")
  run_id=$(printf '%s' "$run" | jq -r '.runId // .id // empty')
  [ -n "$run_id" ] || die "init: run-create receipt has no runId"

  save_state "$feature" "$(jq -n --arg f "$feature" --arg o "$objective" --arg r "$run_id" \
    --arg p "$wpath" --arg b "$wbranch" --arg s "$wsel" --arg m "$main" --arg log "$fdir/routing.jsonl" \
    --arg base "$base" '{feature:$f, objective:$o, run:$r, main:$m, routingLog:$log,
      workspace:{path:$p, branch:$b, base:$base, selector:$s}, tasks:{}}')"

  mark init "$run_id"
  [ "$(cfg '[.models.catalog // {} | .[] | select(type=="object" and .agent=="claude" and .enabled != false)] | length')" = 0 ] \
    || claude_write_check "$main"
  local coord; coord=$(whoami_line)
  if [ ! -f "$fdir/handoff.md" ]; then
    cat >"$fdir/handoff.md" <<EOF
# Handoff: $objective

- Repo: $main. Workspace: $wpath, branch $wbranch (base $base).
- Coordinator: $coord.
- Run: $run_id. Routing log: routing.jsonl. State: run.json (bin/team).
- Stage: planning.
- Tasks: see \`team status $feature\`.
- Next: grill-with-docs, to-spec, to-tickets.
- Skills: orchestrator, orchestration; orca-cli only when a step needs it.
EOF
  fi

  "$ORCA" worktree set --worktree "$wsel" --workspace-status in-progress --environment "$ORCA_ENV" --json >/dev/null 2>&1 \
    || echo "team: could not set board status (non-fatal)" >&2
  if [ $here = 0 ] && [ "$(real "$wpath")" != "$(real "$PWD")" ]; then
    echo "team: workers start in $wpath. This session can stay where it is and keep running team commands;" >&2
    echo "team: to move coordination there, follow start.md \"Shared feature workspace\" (handoff.md, new coordinator session)." >&2
  fi
  jq . "$state"
}

cmd_spec() {
  set -e
  local feature=$1 role=${2:-}; shift 2 || true
  case $role in builder|reviewer|support-engineer) ;; *) die "spec: unknown feature or role '${role}' (roles: $ROLES; features: $(features | paste -sd, -))";; esac
  local kind="" round="" cause="" catalog="" tier="" ticket="" name="" goal="" scope="" selection="" reuse="" same_ok=0
  local extra_c=() extra_s=() extra_r=()
  while [ $# -gt 0 ]; do case $1 in
    --constraint) extra_c+=("$2"); shift 2;; --skill) extra_s+=("$2"); shift 2;; --ref) extra_r+=("$2"); shift 2;;
    --kind) kind=$2; shift 2;; --round) round=$2; shift 2;; --cause) cause=$2; shift 2;;
    --catalog) catalog=$2; shift 2;; --tier) tier=$2; shift 2;; --ticket) ticket=$2; shift 2;;
    --name) name=$2; shift 2;; --goal) goal=$2; shift 2;; --scope) scope=$2; shift 2;;
    --selection) selection=$2; shift 2;; --reuse) reuse=$2; shift 2;; --same-agent-ok) same_ok=1; shift;;
    *) die "spec: unknown $1";; esac; done
  [ -n "$kind" ] || case $role in reviewer) kind=review;; builder) kind=build;; *) kind=other;; esac
  case $kind in build|review|fix|re-review|delivery|close|merge|other) ;; *) die "spec: bad --kind $kind";; esac
  case $kind in fix|re-review) [[ "$round" =~ ^[1-9][0-9]*$ ]] || die "spec: --round N (positive) required for $kind";; esac
  [ -z "$cause" ] || case $cause in defect|requirements|scope|standards) ;; *) die "spec: bad --cause $cause";; esac
  [ -z "$ticket" ] || [ -z "$goal$scope" ] || die "spec: --ticket replaces --goal/--scope; pass one or the other"
  [ -z "$ticket" ] || [ -f "$ticket" ] || die "spec: ticket $ticket not found"

  local st fdir; st=$(load_state "$feature"); fdir=$(feature_dir "$feature")

  # Everything that can refuse runs before the file is written, so a refusal leaves no spec behind.
  local routing
  if [ -n "$catalog" ]; then
    routing=$(routing_for "$role" "$catalog" "$tier")
  elif [ -n "$reuse" ]; then
    local prev; prev=$(last_of_role "$st" "$reuse")
    [ -n "$prev" ] || die "spec: --reuse $reuse: no dispatched $reuse Task in run.json"
    routing=$(spec_line "$(jq -r --arg t "$prev" '.tasks[$t].spec' <<<"$st")" Routing)
    [ -z "$tier" ] || [ "$(jq -r .tier <<<"$routing")" = "$tier" ] || die "spec: --reuse $reuse runs at tier $(jq -r .tier <<<"$routing"), not $tier"
  else
    routing=$(jq -nc --arg t "${tier:-work}" '{tier:$t, catalog:"FILL", agent:"FILL", model:null, effort:null}')
  fi
  [ -n "$reuse" ] || check_independent "$st" "$role" "$(jq -r '.agent // empty' <<<"$routing")" $same_ok
  local measurement
  measurement=$(jq -nc --arg k "$kind" --arg r "$round" --arg c "$cause" \
    '{kind:$k, round:(if $r=="" then null else ($r|tonumber) end), cause:(if $c=="" then null else $c end)}')

  local n; n=$(find "$fdir/specs" -maxdepth 1 -name '[0-9][0-9]-*.md' 2>/dev/null | sed -E 's#.*/([0-9]+)-.*#\1#' | sort -n | tail -1)
  n=$(printf '%02d' $(( 10#${n:-0} + 1 )))
  local suffix=""; [ -n "$round" ] && suffix="-r$round"; [ -n "$name" ] && suffix="-$name"
  local base="$n-$role$suffix" spec="$fdir/specs/$n-$role$suffix.md"

  local wpath wbranch run log peers verify serial skills
  wpath=$(jq -r .workspace.path <<<"$st"); wbranch=$(jq -r .workspace.branch <<<"$st")
  run=$(jq -r .run <<<"$st"); log=$(jq -r .routingLog <<<"$st")
  peers=$(jq -r '[.tasks | to_entries[] | "\(.key) \(.value.role) dispatch:\(.value.dispatches[-1].id // "none")"] | join("; ")' <<<"$st")
  verify=$(cfg '.commands.verify // [] | if type=="array" then join("; ") else tostring end')
  serial=$(cfg '.commands.serial // empty')
  skills="$SKILLS_DIR/team-$role/SKILL.md first"
  case $role in reviewer) skills="$skills; $SKILLS_DIR/code-review/SKILL.md; $SKILLS_DIR/anti-ai/SKILL.md";; esac
  local x; for x in ${extra_s[@]+"${extra_s[@]}"}; do skills="$skills; $x"; done
  local constraints="Finish: the report at Output is prefilled; replace its FILL lines, then run \`$TEAM_BIN submit <Output path>\`. It checks the report and sends worker_done for you: do not send worker_done yourself. Worker communication: $SKILLS_DIR/orchestrator/references/reports.md \"Worker communication\". Browser: Orca via orca-cli only."
  constraints="$constraints$(cfg '[
      (if .matt.glossary then "Glossary: \(.matt.glossary)." else empty end),
      (if .matt.adr then "ADRs: \(.matt.adr)." else empty end),
      (if (.human_only // []) | length > 0 then "Human only (list for the PO, do not perform): \(.human_only | join(", "))." else empty end),
      (if .codegraph == "on" or .codegraph == true then "Code search: codegraph first (`codegraph_explore` MCP or `codegraph explore|callers|impact` CLI) for symbols, callers and impact; `rg` only for literal text. Do not `cat` whole files to find a symbol." else empty end)
    ] | map(" " + .) | join("")')"
  for x in ${extra_c[@]+"${extra_c[@]}"}; do constraints="$constraints $x"; done
  local refs="none"; [ ${#extra_r[@]} = 0 ] || refs=$(printf '%s; ' "${extra_r[@]}" | sed 's/; $//')

  {
    echo "Role: $role"
    echo "Run: $run"
    echo "Measurement: $measurement"
    echo "Routing: $routing"
    echo "Routing-log: $log"
    echo "Selection: ${selection:-$FILL why this tier and catalog entry fit the Task}"
    if [ -n "$ticket" ]; then echo "Ticket: $(abs_path "$ticket")"
    else
      echo "Goal: ${goal:-$FILL observable result}"
      echo "Scope: ${scope:-$FILL entry points, editable paths, spec/decisions by path}"
    fi
    if [ -f "$fdir/spec.md" ]; then echo "Spec: $fdir/spec.md"; else echo "Spec: none (no to-spec for this feature)"; fi
    echo "Workspace: path:$wpath, branch $wbranch. Do not change checkout/branch without coordinator approval."
    echo "Peers: ${peers:-none yet}"
    echo "Constraints: $constraints"
    echo "Skills: $skills"
    echo "Refs: $refs"
    echo "Evidence: ${verify:-$FILL acceptance checks}${serial:+ (serial: $serial)}"
    echo "Output: $fdir/reports/$base.md (prefilled at dispatch; format: $SKILLS_DIR/orchestrator/references/reports.md); raw logs $fdir/logs/$n-<command>.log"
  } >"$spec"
  echo "$spec"
}

validate_spec() { # spec run -> role
  set -e
  local spec=$1 run=$2 role k m open
  [ -f "$spec" ] || die "spec $spec not found"
  for k in Role Run Measurement Routing Routing-log Output; do
    [ -n "$(spec_line "$spec" "$k")" ] || die "spec $spec: missing '$k:' line"; done
  open=$(grep "$FILL" "$spec" | cut -d: -f1 | paste -sd, - || true)
  [ -z "$open" ] || die "spec $spec: unresolved FILL in $open (edit the file, or pass --selection/--goal/--scope to spec/start)"
  grep -q '"FILL"' "$spec" && die "spec $spec: Routing still has FILL values (pass --catalog or --reuse)"
  [ "$(spec_line "$spec" Run)" = "$run" ] || die "spec $spec: Run is not $run"
  role=$(spec_line "$spec" Role)
  case $role in builder|reviewer|support-engineer) ;; *) die "spec $spec: bad Role $role";; esac
  m=$(spec_line "$spec" Measurement)
  jq -e . <<<"$m" >/dev/null 2>&1 || die "spec $spec: Measurement is not JSON"
  jq -e . <<<"$(spec_line "$spec" Routing)" >/dev/null 2>&1 || die "spec $spec: Routing is not JSON"
  case $(jq -r .kind <<<"$m") in fix|re-review)
    jq -e '.round|type=="number" and .>0' <<<"$m" >/dev/null || die "spec $spec: $(jq -r .kind <<<"$m") needs a positive round";; esac
  echo "$role"
}

default_title() { # spec -> ticket name or Goal, prefixed with the kind for follow-ups ("fix r1: ...")
  local t what pre; t=$(spec_line "$1" Ticket)
  if [ -n "$t" ]; then what=$(basename "$t" .md | sed -E 's/^[0-9]+-//; s/-/ /g')
  else what=$(spec_line "$1" Goal | cut -c1-70); fi
  [ -n "$what" ] || return 0
  pre=$(spec_line "$1" Measurement | jq -r 'if .kind == "build" or .kind == "review" then "" else .kind + (if .round then " r\(.round)" else "" end) + ": " end' 2>/dev/null || true)
  echo "$pre$what"
}

cmd_task() {
  set -e
  local feature=$1 spec=${2:-}; [ -n "$spec" ] || die "task: <spec> required"; shift 2
  local title="" deps=""
  while [ $# -gt 0 ]; do case $1 in
    --title) title=$2; shift 2;; --deps) deps=$2; shift 2;; *) die "task: unknown $1";; esac; done
  spec=$(abs_path "$spec")
  local st run role; st=$(load_state "$feature"); run=$(jq -r .run <<<"$st")
  role=$(validate_spec "$spec" "$run")
  [ -n "$title" ] || title=$(default_title "$spec")
  [ -n "$title" ] || die "task: --title required (spec has no Ticket or Goal)"
  case $title in "$role: "*) ;; *) title="$role: $title";; esac

  local args=(orchestration task-create --run "$run" --spec-file "$spec" --task-title "$title")
  [ -z "$deps" ] || args+=(--deps "$(jq -nc --arg d "$deps" '$d | split(",") | map(select(. != ""))')")
  local res task_id; res=$(orca_call "${args[@]}")
  task_id=$(jq -r '.taskId // .id // empty' <<<"$res"); [ -n "$task_id" ] || die "task: receipt has no taskId"
  st=$(jq --arg t "$task_id" --arg s "$spec" --arg r "$role" --arg ti "$title" \
    '.tasks[$t] = {spec:$s, role:$r, title:$ti, dispatches:[]}' <<<"$st")
  save_state "$feature" "$st"
  mark task "$run" task "$task_id"
  echo "$task_id"
}

cmd_dispatch() {
  set -e
  local feature=$1 ref=${2:-}; [ -n "$ref" ] || die "dispatch: <task-id|spec> required"; shift 2
  local terminal="" reuse="" same_ok=0 catalog=""
  while [ $# -gt 0 ]; do case $1 in
    --terminal) terminal=$2; shift 2;; --reuse) reuse=$2; shift 2;; --same-agent-ok) same_ok=1; shift;;
    --catalog) catalog=$2; shift 2;;
    *) die "dispatch: unknown $1";; esac; done
  [ -z "$catalog" ] || [ -z "$terminal$reuse" ] || die "dispatch: --catalog starts a new worker; it excludes --terminal and --reuse"
  local st run task_id spec role
  st=$(load_state "$feature"); run=$(jq -r .run <<<"$st")
  if [ -n "$reuse" ]; then
    [ -z "$terminal" ] || die "dispatch: --terminal and --reuse are exclusive"
    local prev; prev=$(last_of_role "$st" "$reuse")
    terminal=$(jq -r --arg t "$prev" '.tasks[$t].dispatches[-1].terminal // empty' <<<"$st")
    [ -n "$terminal" ] || die "dispatch: --reuse $reuse: no $reuse worker terminal in run.json"
  fi
  if [ -f "$ref" ]; then
    spec=$(abs_path "$ref")
    task_id=$(jq -r --arg s "$spec" '[.tasks | to_entries[] | select(.value.spec==$s) | .key][-1] // empty' <<<"$st")
    [ -n "$task_id" ] || die "dispatch: no Task for $spec; run team task first"
  else
    task_id=$ref; spec=$(jq -r --arg t "$task_id" '.tasks[$t].spec // empty' <<<"$st")
    [ -n "$spec" ] || die "dispatch: $task_id not in run.json"
  fi
  role=$(jq -r --arg t "$task_id" '.tasks[$t].role' <<<"$st")
  local routing agent model effort
  routing=$(spec_line "$spec" Routing)
  if [ -n "$catalog" ]; then # retry on another entry of the same tier (routing.md); the spec keeps the first
    local tier; tier=$(jq -r .tier <<<"$routing")
    routing=$(routing_for "$role" "$catalog" "$tier")
  fi
  agent=$(jq -r '.agent // empty' <<<"$routing"); model=$(jq -r '.model // empty' <<<"$routing")
  effort=$(jq -r '.effort // empty' <<<"$routing")

  [ -n "$terminal" ] || check_independent "$st" "$role" "$agent" $same_ok

  local args=(orchestration worker-start --run "$run" --task "$task_id" --keep-open)
  if [ -n "$terminal" ]; then
    args+=(--terminal "$terminal")
  else
    [ -n "$agent" ] || die "dispatch: Routing has no agent in $spec"
    args+=(--worktree "$(jq -r .workspace.selector <<<"$st")" --agent "$agent")
    if [ -n "$model" ]; then args+=(--model "$model"); [ -n "$effort" ] && args+=(--effort "$effort"); fi
  fi
  [ -n "$terminal" ] || [ "$agent" != claude ] || claude_write_check "$(jq -r .main <<<"$st")"
  local res d; res=$(orca_call "${args[@]}")
  d=$(jq -r '.dispatchId // empty' <<<"$res"); [ -n "$d" ] || { echo "$res" >&2; die "dispatch: receipt has no dispatchId"; }
  local r_agent r_model r_effort r_term
  r_agent=$(jq -r --arg a "$agent" '.agent // $a' <<<"$res"); r_model=$(jq -r '.model // empty' <<<"$res")
  r_effort=$(jq -r '.effort // empty' <<<"$res"); r_term=$(jq -r --arg t "$terminal" '.terminal // $t' <<<"$res")
  [ -n "$r_model" ] || r_model=$model; [ -n "$r_effort" ] || r_effort=$effort

  local log; log=$(jq -r .routingLog <<<"$st")
  if ! { [ -f "$log" ] && jq -e --arg d "$d" 'select(.dispatch==$d)' "$log" 2>/dev/null | grep -q .; }; then
    jq -nc --arg t "$task_id" --arg d "$d" --argjson r "$routing" --arg a "$r_agent" --arg m "$r_model" --arg e "$r_effort" \
      '{task:$t, dispatch:$d, tier:$r.tier, catalog:$r.catalog, agent:$a,
        model:(if $m=="" then null else $m end), effort:(if $e=="" then null else $e end)}' >>"$log"
  fi
  st=$(jq --arg t "$task_id" --arg d "$d" --arg term "$r_term" --arg a "$r_agent" \
    '.tasks[$t].dispatches |= ((map(select(.id != $d))) + [{id:$d, terminal:$term, agent:$a}])' <<<"$st")
  save_state "$feature" "$st"
  write_skeleton "$(report_of "$spec")" "$role" "$run" "$task_id" "$d" "$(jq -r .workspace.path <<<"$st")" "$(jq -r .workspace.branch <<<"$st")"
  mark dispatch "$run" task "$task_id" dispatch "$d"
  jq -c --arg t "$task_id" '{task:$t, dispatch:.dispatchId, terminal, next}' <<<"$res"
}

cmd_start() {
  local feature=$1 target=${2:-}; [ -n "$target" ] || die "start: <spec|role> required"; shift 2
  local sargs=() targs=() dargs=() same_ok=0 terminal=""
  while [ $# -gt 0 ]; do case $1 in
    --kind|--round|--cause|--catalog|--tier|--ticket|--name|--goal|--scope|--selection|--constraint|--skill|--ref) sargs+=("$1" "$2"); shift 2;;
    --reuse) sargs+=("$1" "$2"); dargs+=("$1" "$2"); terminal=reuse; shift 2;;
    --same-agent-ok) sargs+=("$1"); dargs+=("$1"); same_ok=1; shift;;
    --title|--deps) targs+=("$1" "$2"); shift 2;;
    --terminal) dargs+=("$1" "$2"); terminal=$2; shift 2;;
    *) die "start: unknown $1";; esac; done

  local spec made=0
  if [ ! -f "$target" ] && [[ "$target" =~ ^($ROLES)$ ]]; then
    spec=$(cmd_spec "$feature" "$target" ${sargs[@]+"${sargs[@]}"}); made=1
  else
    [ ${#sargs[@]} = 0 ] || [ "${sargs[*]}" = "--same-agent-ok" ] || [ "${sargs[0]}" = --reuse ] \
      || die "start: spec flags (${sargs[0]}) need a role, not an existing spec"
    spec=$target
    [ -n "$terminal" ] || check_independent "$(load_state "$feature")" "$(spec_line "$spec" Role)" \
      "$(spec_line "$spec" Routing | jq -r '.agent // empty' 2>/dev/null)" $same_ok
  fi
  # A refused Task removes the spec start wrote, so its number is not consumed. (Not `if !`: that
  # would switch off set -e inside cmd_task.)
  if [ $made = 1 ]; then
    UNDO_SPEC=$spec
    trap '[ -z "${UNDO_SPEC:-}" ] || { rm -f "$UNDO_SPEC"; echo "team: removed $UNDO_SPEC" >&2; }' EXIT
  fi
  local task_id; task_id=$(cmd_task "$feature" "$spec" ${targs[@]+"${targs[@]}"})
  UNDO_SPEC=""
  [ $made = 1 ] && echo "team: spec $spec" >&2
  # A refused start leaves a ready Task with no worker. Do not touch it: say how to settle it.
  trap 'echo "team: Task $task_id is ready with no worker. Same spec, cause fixed: team dispatch $feature $task_id. Spec wrong (Routing is create-only): orca orchestration task-update --id $task_id --status failed --result \"<why>\", then a new team start." >&2' EXIT
  cmd_dispatch "$feature" "$task_id" ${dargs[@]+"${dargs[@]}"}
  trap - EXIT
}

# team solo: a PO-invoked senior session (skills/senior-*) is its own worker. It gets the same Run,
# spec, Task and prefilled report as a dispatched Builder, and a Dispatch to its own terminal, so the
# dashboard shows the Task in progress and links this session to the Run. team submit finishes it.
cmd_solo() {
  set -e
  local feature=${1:-}; [ -n "$feature" ] && [ "${feature#-}" = "$feature" ] || die "solo: feature name required"; shift
  local role="" goal="" scope="" branch="" base="" wt=0
  while [ $# -gt 0 ]; do case $1 in
    --role) role=$2; shift 2;; --goal) goal=$2; shift 2;; --scope) scope=$2; shift 2;;
    --branch) branch=$2; shift 2;; --base) base=$2; shift 2;; --worktree) wt=1; shift;;
    *) die "solo: unknown $1";; esac; done
  [[ "$role" =~ ^($SENIOR)$ ]] || die "solo: --role must be ${SENIOR//|/ or }"
  [ -n "$goal" ] || die "solo: --goal required"

  local fdir ex; fdir=$(feature_dir "$feature")
  if ! git -C "$(main_checkout)" check-ignore -q .team 2>/dev/null; then # init-team step 1, for repos without it
    ex="$(git rev-parse --path-format=absolute --git-common-dir)/info/exclude"; mkdir -p "$(dirname "$ex")"; echo "/.team" >>"$ex"
  fi
  if [ -f "$fdir/run.json" ]; then
    cmd_init "$feature" --objective "$goal" >/dev/null
  else
    [ -n "$base" ] || base=$(cfg '.branches.base // "main"')
    [ -n "$branch" ] || branch="feat/$feature"
    if [ $wt = 0 ] && [ "$(git symbolic-ref --short -q HEAD || true)" = "$base" ]; then
      if git show-ref --verify -q "refs/heads/$branch"; then git switch -q "$branch"; else git switch -q -c "$branch"; fi
      echo "team: switched to $branch (off $base)" >&2
    fi
    local had=0; [ -f "$fdir/handoff.md" ] && had=1
    local iargs=(--objective "$goal" --branch "$branch" --base "$base"); [ $wt = 1 ] || iargs+=(--here)
    cmd_init "$feature" "${iargs[@]}" >/dev/null
    if [ $had = 0 ]; then
      local tmpf; tmpf=$(mktemp)
      sed -e "s/^- Next: .*/- Next: $role works the Task itself (team solo), then team submit./" \
        -e "s/^- Skills: .*/- Skills: $role./" "$fdir/handoff.md" >"$tmpf" && cat "$tmpf" >"$fdir/handoff.md"; rm -f "$tmpf"
    fi
  fi

  local st run wpath wbranch handle task_id spec report d=""
  st=$(load_state "$feature"); run=$(jq -r .run <<<"$st")
  wpath=$(jq -r .workspace.path <<<"$st"); wbranch=$(jq -r .workspace.branch <<<"$st")
  handle=$(whoami_json | jq -r '.terminal // empty')
  task_id=$(jq -r --arg r "$role" '[.tasks | to_entries[] | select(.value.role==$r and (.value.done|not)) | .key] | last // empty' <<<"$st")

  if [ -n "$task_id" ]; then # resume the open Task; dispatch again unless it is still in progress
    spec=$(jq -r --arg t "$task_id" '.tasks[$t].spec' <<<"$st"); report=$(report_of "$spec")
    echo "team: resuming $task_id ($spec)" >&2; mark task "$run" task "$task_id"
    local status; status=$(orca_call orchestration task-list --run "$run" | jq -r --arg t "$task_id" '.tasks[] | select(.id==$t) | .status')
    [ "$status" = dispatched ] && d=$(jq -r --arg t "$task_id" '.tasks[$t].self.dispatch // empty' <<<"$st")
  else
    local n; n=$(find "$fdir/specs" -maxdepth 1 -name '[0-9][0-9]-*.md' 2>/dev/null | sed -E 's#.*/([0-9]+)-.*#\1#' | sort -n | tail -1)
    n=$(printf '%02d' $(( 10#${n:-0} + 1 )))
    spec="$fdir/specs/$n-$role.md"; report="$fdir/reports/$n-$role.md"
    local verify; verify=$(cfg '.commands.verify // [] | if type=="array" then join("; ") else tostring end')
    {
      echo "Role: $role"
      echo "Run: $run"
      echo 'Measurement: {"kind":"build","round":null,"cause":null}'
      echo "Goal: $goal"
      echo "Scope: ${scope:-set by the $role session within the Goal}"
      echo "Spec: none (PO-invoked $role session)"
      echo "Workspace: path:$wpath, branch $wbranch."
      echo "Skills: $SKILLS_DIR/$role/SKILL.md"
      echo "Evidence: ${verify:-acceptance checks named in the report}"
      echo "Output: $report (prefilled; format: $SKILLS_DIR/orchestrator/references/reports.md)"
    } >"$spec"
    local res; res=$(orca_call orchestration task-create --run "$run" --spec-file "$spec" --task-title "$role: ${goal:0:70}")
    task_id=$(jq -r '.taskId // .id // empty' <<<"$res"); [ -n "$task_id" ] || die "solo: receipt has no taskId"
    st=$(jq --arg t "$task_id" --arg s "$spec" --arg r "$role" --arg ti "$role: ${goal:0:70}" \
      '.tasks[$t] = {spec:$s, role:$r, title:$ti, dispatches:[]}' <<<"$st")
    save_state "$feature" "$st"; mark task "$run" task "$task_id"
  fi

  if [ -z "$d" ] && [ -n "$handle" ]; then
    local res; res=$(orca_call orchestration dispatch --task "$task_id" --to "$handle" --run "$run")
    d=$(jq -r '.dispatch.id // .dispatchId // empty' <<<"$res")
    [ -n "$d" ] || { echo "$res" >&2; die "solo: dispatch receipt has no id"; }
    st=$(jq --arg t "$task_id" --arg d "$d" --arg h "$handle" '.tasks[$t].self = {dispatch:$d, terminal:$h}' <<<"$(load_state "$feature")")
    save_state "$feature" "$st"; mark dispatch "$run" task "$task_id" dispatch "$d"
  elif [ -z "$handle" ]; then
    echo "team: no Orca terminal in this session; the Task stays ready on the dashboard until team submit" >&2
  fi
  report_written "$report" || write_skeleton "$report" "$role" "$run" "$task_id" "${d:-none}" "$wpath" "$wbranch"
  jq -n --arg f "$feature" --arg r "$run" --arg t "$task_id" --arg d "${d:-none}" --arg p "$wpath" --arg b "$wbranch" \
    --arg s "$spec" --arg o "$report" '{feature:$f, run:$r, task:$t, dispatch:$d, workspace:$p, branch:$b, spec:$s, report:$o}'
}

# solo_finish path role run task verdict-word verdict-line summary: team submit's end for senior roles.
solo_finish() {
  local path=$1 role=$2 run=$3 task=$4 ok=$5 verdict=$6 summary=$7 status fdir feature
  # Orca refuses blocked while the self-Dispatch is active: partial and blocked keep the Task in progress.
  case $ok in implemented) status=completed;; failed) status=failed;; *) status="in progress";; esac
  fdir=$(dirname "$(dirname "$path")"); feature=$(basename "$fdir")
  local body; body=${summary:-$(section "$path" Result | tr '\n' ' ' | sed -E 's/  +/ /g' | cut -c1-600)}
  [ "$status" = "in progress" ] \
    || orca_call orchestration task-update --id "$task" --run "$run" --status "$status" --result "$body Report: $path" >/dev/null
  processed "$feature" "$task" "$(feature_dir "$feature")/reports/$(basename "$path")" "${verdict:0:80}" "PO"
  [ "$status" = "in progress" ] || save_state "$feature" "$(jq --arg t "$task" --arg v "$ok" '.tasks[$t].done = $v' <<<"$(load_state "$feature")")"
  echo "Task $task: $status ($role). Report: $path"
}

# whoami_json: this session's Orca identity from the runtime environment (pane key -> agent list).
whoami_json() {
  local agents=""
  [ -n "${ORCA_PANE_KEY:-}" ] && agents=$("$ORCA" agent list --environment "$ORCA_ENV" --json 2>/dev/null || true)
  jq -nc --arg h "${ORCA_TERMINAL_HANDLE:-}" --arg p "${ORCA_PANE_KEY:-}" --arg a "$agents" '
    ($a | try fromjson catch null | .result.agents // [] | map(select(.paneKey == $p and $p != "")) | .[0]) as $me
    | {terminal:(if $h == "" then null else $h end), session:($me.orcaSessionId // null),
       agent:($me.agent // null), kind:($me.kind // null), repo:($me.repo // null)}'
}
whoami_line() {
  local w; w=$(whoami_json)
  if [ "$(jq -r '.terminal // .session // empty' <<<"$w")" = "" ]; then
    echo "$FILL receiver identity and surface (start.md \"Coordinator delivery\"); team found no Orca identity in this environment"
  else
    jq -r '"\(.agent // "?") \(.kind // "?"), terminal \(.terminal // "none"), orca_session_id:\(.session // "unknown") (team whoami)"' <<<"$w"
  fi
}

# ---------- worker reports ----------

report_written() { [ -f "$1" ] && ! grep -q "^$SKELETON" "$1"; }
verdicts_of() {
  case $1 in
    builder|senior-*) echo "implemented|partial|blocked|failed";;
    reviewer) echo "pass|changes requested|blocked|inconclusive";;
    support-engineer) echo "confirmed|not reproduced|needs clarification|blocked";;
  esac
}

# write_skeleton path role run task dispatch workspace branch: the report the worker fills in. A report
# a worker already wrote at that path (an earlier Dispatch) is kept as <name>-<its dispatch>.md.
write_skeleton() {
  local path=$1 role=$2 v; v=$(verdicts_of "$role" | sed 's/|/, /g')
  mkdir -p "$(dirname "$path")"
  if report_written "$path"; then
    local old; old=$(spec_line "$path" Dispatch); old=${old:-previous}
    mv "$path" "${path%.md}-$old.md"; echo "kept earlier report: ${path%.md}-$old.md" >&2
  fi
  {
    echo "$SKELETON: replace every FILL line; delete OPTIONAL lines you do not use; then run: $TEAM_BIN submit $path -->"
    echo "Role: $role"; echo "Run: $3"; echo "Task: $4"; echo "Dispatch: $5"
    echo "Workspace: $6 (branch $7)"
    echo "Revision: set by team submit"
    echo
    echo "## Result"
    case $role in
      builder|senior-*) echo "FILL: verdict word first ($v), then the behavior delivered and criteria left unmet.";;
      reviewer) echo "FILL: verdict word first ($v), then the reviewed base...HEAD.";;
      *) echo "FILL: verdict word first ($v), then the answer to the investigation question.";;
    esac
    echo "## Evidence"
    case $role in
      builder|senior-*) echo "FILL: each acceptance criterion with its check and result; failing-before and passing-after output; the team verify lines (run it after the final commit); other raw logs under logs/.";;
      reviewer) echo "FILL: team verify --reuse lines; acceptance evidence inspected; targeted checks run.";;
      *) echo "FILL: requirements summary (at most 10 lines); reproduction and impact; confirmed cause or labelled hypotheses; affected path:line.";;
    esac
    case $role in
      reviewer)
        echo "## Standards"
        echo "FILL: findings S1.. (Must fix or Should fix, file:line, impact, evidence; tags mechanical/recurring), or \"No findings.\" Re-review: each prior ID resolved or not."
        echo "## Spec"
        echo "FILL: findings P1.. quoting the violated ticket/spec line, or \"No findings.\"";;
      builder|senior-*)
        echo "## Findings"; echo "OPTIONAL: fix rounds: each finding ID with its fix commit or evidence-based rejection."
        echo "## Changed paths"; echo "OPTIONAL: paths changed."
        echo "## Commit body"; echo "OPTIONAL: when committing or delivering.";;
      *)
        echo "## Findings"; echo "OPTIONAL: proposed next step and effort drivers; ticket replies add a client-language draft and a PO translation.";;
    esac
    echo "## Leftovers"; echo "OPTIONAL: open risks and human steps."
  } >"$path"
}

section() { awk -v h="## $2" '$0==h{f=1;next} f&&/^## /{exit} f' "$1"; }

# team submit <report> [--summary text] [--check] [--from id]: run by the worker. Checks the report,
# records Revision, drops unused OPTIONAL sections, then sends worker_done with the outcome the
# verdict implies. --check stops before sending (also for PO-invoked roles without a Task).
cmd_submit() {
  local path="" summary="" check=0 from=""
  while [ $# -gt 0 ]; do case $1 in
    --summary) summary=$2; shift 2;; --check) check=1; shift;; --from) from=$2; shift 2;;
    -*) die "submit: unknown $1";; *) [ -z "$path" ] || die "submit: one report path"; path=$1; shift;; esac; done
  [ -n "$path" ] || die "submit: <report path> required (the spec's Output)"
  [ -f "$path" ] || die "submit: $path not found"
  path=$(abs_path "$path")
  local role run task dispatch ws errs=()
  role=$(spec_line "$path" Role); run=$(spec_line "$path" Run); task=$(spec_line "$path" Task)
  dispatch=$(spec_line "$path" Dispatch); ws=$(spec_line "$path" Workspace | sed -E 's/ \(branch .*//')
  local as=$role; [[ "$role" =~ ^($SENIOR)$ ]] && as=builder # senior roles pass the Builder's checks
  case $as in builder|reviewer|support-engineer) ;; *) die "submit: Role: must be builder, reviewer, support-engineer, ${SENIOR//|/ or }";; esac
  [ $check = 1 ] || { [ -n "$run" ] && [ -n "$task" ] && [ -n "$dispatch" ]; } \
    || die "submit: Run, Task and Dispatch lines are required to send worker_done (--check validates only)"

  local fills; fills=$(grep -n "^$FILL" "$path" | cut -d: -f1 | paste -sd, - || true)
  [ -z "$fills" ] || errs+=("unfilled FILL lines: $fills")
  local verdict word ok=""; verdict=$(section "$path" Result | awk 'NF{print;exit}')
  word=$(verdicts_of "$role")
  shopt -s nocasematch
  local w; IFS='|' read -ra ws_ <<<"$word"
  for w in "${ws_[@]}"; do [[ "$verdict" =~ ^$w($|[.:,;[:space:]]) ]] && ok=$w; done
  shopt -u nocasematch
  [ -n "$ok" ] || errs+=("## Result must start with the verdict word ($(sed 's/|/, /g' <<<"$word")), found: \"${verdict:0:60}\"")
  [ -n "$(section "$path" Evidence | grep -v '^OPTIONAL:' | tr -d '[:space:]')" ] || errs+=("## Evidence is empty")
  if [ "$role" = reviewer ]; then
    for w in Standards Spec; do
      [ -n "$(section "$path" "$w" | tr -d '[:space:]')" ] || errs+=("## $w is missing or empty (write \"No findings.\" for a clean axis)"); done
  fi

  local rev=""
  if [ -n "$ws" ] && git -C "$ws" rev-parse --git-dir >/dev/null 2>&1; then
    local head dirty; head=$(git -C "$ws" rev-parse HEAD); dirty=$(git -C "$ws" status --porcelain | cut -c4- | paste -sd, - || true)
    rev="$head ${dirty:+(uncommitted: $dirty)}"; rev=${rev% }; [ -n "$dirty" ] || rev="$head (clean)"
    [ "$as:$ok" != builder:implemented ] || [ -z "$dirty" ] \
      || errs+=("verdict implemented with uncommitted changes in $ws: $dirty (commit them, or report partial)")
    if [ "$as:$ok" = builder:implemented ] || [ "$as:$ok" = reviewer:pass ]; then
      local vlog re=""; vlog=$(verify_log "$(dirname "$(dirname "$path")")" "$ws"); [ $as = builder ] || re=" --reuse"
      verify_ok "$vlog" || errs+=("verdict $ok needs a green verify at HEAD: run team verify$re (no ok $vlog)")
    fi
  else
    rev="not applicable (no git workspace)"
  fi
  if [ ${#errs[@]} -gt 0 ]; then
    printf 'team: submit: %s\n' "${errs[@]}" >&2; die "submit: fix $path and run it again"
  fi

  # Record the revision, drop the skeleton marker, OPTIONAL hints and the sections they leave empty.
  local tmpf; tmpf=$(mktemp)
  awk -v rev="$rev" -v sk="$SKELETON" '
    index($0, sk) == 1 { next }
    /^Revision:/ { lines[++n] = "Revision: " rev; next }
    /^OPTIONAL:/ { next }
    { lines[++n] = $0 }
    END {
      for (i = 1; i <= n; i++) {
        if (lines[i] ~ /^## /) { j = i + 1; empty = 1
          while (j <= n && lines[j] !~ /^## /) { if (lines[j] ~ /[^[:space:]]/) empty = 0; j++ }
          if (empty) { i = j - 1; continue } }
        print lines[i]
      }
    }' "$path" >"$tmpf" && cat "$tmpf" >"$path" && rm -f "$tmpf"
  echo "report ok: $role, $ok, $rev"
  [ $check = 0 ] || return 0
  if [ "$as" != "$role" ]; then solo_finish "$path" "$role" "$run" "$task" "$ok" "$verdict" "$summary"; return; fi

  local outcome=succeeded; case $ok in blocked|failed) outcome=failed;; esac
  if [ -z "$from" ]; then
    from=$(whoami_json | jq -r '.session // empty'); [ -z "$from" ] || from="orca_session_id:$from"
  fi
  [ -n "$from" ] || die "submit: no Orca session found here; pass --from <the orca_session_id from your preamble>"
  local body; body=${summary:-$(section "$path" Result | tr '\n' ' ' | sed -E 's/  +/ /g' | cut -c1-600)}
  local res; res=$(orca_call orchestration send --from "$from" --type worker_done \
    --subject "$role: ${verdict:0:80}" --body "$body Report: $path" \
    --task-id "$task" --dispatch-id "$dispatch" --outcome "$outcome" --report-path "$path")
  echo "worker_done sent ($outcome): $(jq -c . <<<"$res" | cut -c1-200)"
  echo "Done: return to an idle prompt."
}

# ---------- worker checks ----------

verify_ok() { [ -f "$1" ] && [ "$(tail -1 "$1")" = "# result: ok" ]; }
verify_log() { echo "$1/logs/verify-$(git -C "$2" rev-parse --short=12 HEAD).log"; } # fdir workspace

# team verify [feature] [--reuse]: worker side. commands.verify in the feature workspace, logged as
# logs/verify-<sha>.log; team submit wants a green one at HEAD for implemented and pass.
cmd_verify() {
  set -e
  local feature=$1; shift; local reuse=0
  while [ $# -gt 0 ]; do case $1 in --reuse) reuse=1; shift;; *) die "verify: unknown $1";; esac; done
  local st ws fdir log dirty head
  st=$(load_state "$feature"); ws=$(jq -r .workspace.path <<<"$st"); fdir=$(feature_dir "$feature")
  head=$(git -C "$ws" rev-parse HEAD); log=$(verify_log "$fdir" "$ws"); mkdir -p "$fdir/logs"
  dirty=$(git -C "$ws" status --porcelain | cut -c4- | paste -sd, - || true)
  if [ $reuse = 1 ] && [ -z "$dirty" ] && verify_ok "$log"; then
    echo "verify at $head (clean), reused $log"
    sed -n 's/^# ok: /verify ok (reused): /p' "$log"; return 0
  fi
  if [ -n "$dirty" ]; then
    log=${log%.log}-dirty.log
    echo "team: uncommitted changes ($dirty): this run does not count for team submit" >&2
  fi
  local lock=""
  if [ "$(cfg '.commands.serial // .serial // false')" = true ]; then # one verify at a time across workers
    lock="$(main_checkout)/.team/.verify.lock"
    until mkdir "$lock" 2>/dev/null; do
      local pid; pid=$(cat "$lock/pid" 2>/dev/null || true)
      if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then rm -rf "$lock"; continue; fi
      echo "team: waiting for another verify (serial: true)" >&2; sleep 5
    done
    echo $$ >"$lock/pid"; trap 'rm -rf "$lock"' EXIT
  fi
  echo "verify at $head ($([ -z "$dirty" ] && echo clean || echo "uncommitted: $dirty")), log $log"
  local rc=0; run_verify "$ws" "$log" || rc=1
  [ -z "$lock" ] || { rm -rf "$lock"; trap - EXIT; }
  return $rc
}

# team pr-preflight [feature] <target> [--remote R]: delivery.md "Before a PR from a long-lived
# branch", the read-only part. Lists what needs the PO; merging, migrations and tests stay manual.
cmd_pr_preflight() {
  set -e
  local feature=$1 target=${2:-}; [ -n "$target" ] || die "pr-preflight: <target branch> required"; shift 2
  local remote=origin
  while [ $# -gt 0 ]; do case $1 in --remote) remote=$2; shift 2;; *) die "pr-preflight: unknown $1";; esac; done
  local st ws up me ask=0
  st=$(load_state "$feature"); ws=$(jq -r .workspace.path <<<"$st"); up="$remote/$target"
  git -C "$ws" fetch -q "$remote" || die "pr-preflight: git fetch $remote failed"
  git -C "$ws" rev-parse -q --verify "$up" >/dev/null || die "pr-preflight: $up not found after fetch"
  me=$(git -C "$ws" config user.email || true)
  echo "outgoing $up..HEAD: $(git -C "$ws" rev-list --count "$up..HEAD") commit(s)"
  git -C "$ws" log --format='%an <%ae>' "$up..HEAD" | sort | uniq -c | sed 's/^ */  /'
  local sha email subj
  while IFS=$'\t' read -r sha email subj; do
    [ -n "$sha" ] && [ "$email" != "$me" ] || continue
    [ -z "$(git -C "$ws" branch -r --contains "$sha" 2>/dev/null | head -1)" ] || continue
    git -C "$ws" cherry "$up" "$sha" | grep -q "^- $sha" && continue
    echo "ask PO: ${sha:0:9} by $email ($subj) is on no remote branch and not in $target"; ask=$((ask+1))
  done < <(git -C "$ws" log --format=$'%H\t%ae\t%s' "$up..HEAD")
  local f live
  while IFS=$'\t' read -r sha subj; do
    [ -n "$sha" ] || continue
    live=0
    while IFS= read -r f; do
      [ -n "$f" ] && git -C "$ws" cat-file -e "HEAD:$f" 2>/dev/null || continue
      live=$((live + $(git -C "$ws" blame --line-porcelain HEAD -- "$f" | grep -c "^$sha " || true)))
    done < <(git -C "$ws" show --format= --name-only "$sha")
    if [ $live -gt 0 ]; then echo "wip ${sha:0:9} ($subj): $live live line(s); squash on merge, do not drop"; ask=$((ask+1))
    else echo "wip ${sha:0:9} ($subj): no live lines; safe to drop"; fi
  done < <(git -C "$ws" log -i --grep='^wip' --format=$'%H\t%s' "$up..HEAD")
  echo "preflight: $([ $ask = 0 ] && echo "nothing for the PO" || echo "$ask item(s) for the PO")"
}

# team retry [feature] <task|role> --reason TEXT [--catalog A] [--same-agent-ok]: a worker that failed
# to run (launch, account, crash). Stops its Dispatch, sets the Task ready, dispatches again (on
# another entry of the tier with --catalog) and records the reason in handoff.md.
cmd_retry() {
  set -e
  local feature=$1 ref=${2:-}; [ -n "$ref" ] || die "retry: <task-id|role> required"; shift 2
  local reason="" dargs=()
  while [ $# -gt 0 ]; do case $1 in
    --reason) reason=$2; shift 2;; --catalog) dargs+=(--catalog "$2"); shift 2;; --same-agent-ok) dargs+=("$1"); shift;;
    *) die "retry: unknown $1";; esac; done
  [ -n "$reason" ] || die "retry: --reason required (the error the worker hit)"
  local st run task d status
  st=$(load_state "$feature"); run=$(jq -r .run <<<"$st")
  if [[ "$ref" =~ ^($ROLES)$ ]]; then task=$(last_of_role "$st" "$ref"); else task=$ref; fi
  d=$(jq -r --arg t "$task" '.tasks[$t].dispatches[-1].id // empty' <<<"$st")
  [ -n "$d" ] || die "retry: no Dispatch recorded for $ref"
  status=$(orca_call orchestration task-list --run "$run" | jq -r --arg t "$task" '.tasks[] | select(.id==$t) | .status')
  [ "$status" != completed ] || die "retry: $task is completed; a new round is team fix, rereview or start"
  if [ "${dargs[0]-}" != --catalog ]; then # default: the entry of the failed Dispatch, not the spec's first
    local last; last=$(jq -r --arg d "$d" 'select(.dispatch==$d) | .catalog' "$(jq -r .routingLog <<<"$st")" 2>/dev/null | tail -1)
    [ -z "$last" ] || dargs=(--catalog "$last" ${dargs[@]+"${dargs[@]}"})
  fi
  local spec routing role same=0; spec=$(jq -r --arg t "$task" '.tasks[$t].spec' <<<"$st"); role=$(jq -r --arg t "$task" '.tasks[$t].role' <<<"$st")
  routing=$(spec_line "$spec" Routing)
  [ "${dargs[0]-}" != --catalog ] || routing=$(routing_for "$role" "${dargs[1]}" "$(jq -r .tier <<<"$routing")")
  [[ " ${dargs[*]-} " != *" --same-agent-ok "* ]] || same=1
  check_independent "$st" "$role" "$(jq -r '.agent // empty' <<<"$routing")" $same # refuse before stopping the worker
  local res; res=$(orca_call orchestration worker-stop --dispatch "$d")
  echo "stopped $d: $(jq -r '.state // "ok"' <<<"$res")"
  orca_call orchestration task-update --id "$task" --status ready >/dev/null
  local out; out=$(cmd_dispatch "$feature" "$task" ${dargs[@]+"${dargs[@]}"})
  echo "- Retry: $task | $d -> $(jq -r .dispatch <<<"$out") | $(tail -1 "$(jq -r .routingLog <<<"$st")" | jq -r .catalog) | $reason" >>"$(feature_dir "$feature")/handoff.md"
  echo "$out"
}

# ---------- review rounds ----------

task_index() { jq -r --arg t "$2" '[.tasks | keys_unsorted[]] | index($t)' <<<"$1"; }
report_of() { spec_line "$1" Output | sed -E 's/[; (].*//'; }
spec_round() { spec_line "$1" Measurement | jq -r '.round // 0' 2>/dev/null || echo 0; }
work_args() { # spec -> the --ticket or --goal/--scope flags that spec was written with, one per line
  local tk; tk=$(spec_line "$1" Ticket)
  if [ -n "$tk" ]; then printf '%s\n' --ticket "$tk"
  else printf '%s\n' --goal "$(spec_line "$1" Goal)" --scope "$(spec_line "$1" Scope)"; fi
}
processed() { # feature task report verdict next: handoff line per start.md "Handoff"
  local fdir st d head; fdir=$(feature_dir "$1"); st=$(load_state "$1")
  d=$(jq -r --arg t "$2" '.tasks[$t].dispatches[-1].id // .tasks[$t].self.dispatch // "-"' <<<"$st")
  head=$(git -C "$(jq -r .workspace.path <<<"$st")" rev-parse --short HEAD 2>/dev/null || echo "?")
  echo "- Processed: $2 | $d | ${3#"$fdir"/} | $4 | $head | $5" >>"$fdir/handoff.md"
}
# round_source feature role want-after-role -> task id of the role's latest Task, refusing when a
# want-after-role Task already follows it (that round was started).
round_source() {
  set -e
  local st t a; st=$(load_state "$1"); t=$(last_of_role "$st" "$2")
  [ -n "$t" ] || die "no dispatched $2 Task in run.json"
  a=$(last_of_role "$st" "$3")
  [ -z "$a" ] || [ "$(task_index "$st" "$a")" -lt "$(task_index "$st" "$t")" ] \
    || die "$3 Task $a already follows $2 Task $t"
  echo "$t"
}
round_report() { # spec role -> report path, refusing a missing one
  local r; r=$(report_of "$1")
  report_written "$r" || die "$2 report missing: $r (team read $2; ask the worker to write it)"
  echo "$r"
}

# read_verdict report want read-as context -> verdict for the handoff. The report's own verdict must
# start with <want>; otherwise the Orchestrator, having read the report, states it with --read-as.
read_verdict() {
  set -e
  local v; v=$(report_verdict "$1")
  shopt -s nocasematch
  if [[ "$v" == "$2"* ]]; then echo "$v"
  elif [ -z "$3" ]; then die "$4 says \"$v\", not $2. If the report means $2, pass --read-as \"$2\"; otherwise settle it first."
  elif [[ "$3" == "$2" ]]; then echo "$2 (read as; report: ${v:0:60})"
  else die "--read-as must be \"$2\""; fi
}

# run_verify dir log: commands.verify in dir, all output to log; prints one line per command.
run_verify() {
  local dir=$1 log=$2 c ok=0 n=0
  : >"$log"
  while IFS= read -r c; do
    [ -n "$c" ] || continue; n=$((n+1))
    echo "\$ $c" >>"$log"
    if (cd "$dir" && sh -c "$c") >>"$log" 2>&1; then echo "verify ok: $c"; echo "# ok: $c" >>"$log"
    else echo "verify FAILED: $c (log $log)"; echo "# FAILED: $c" >>"$log"; ok=1; fi
  done < <(cfg '.commands.verify // [] | if type=="array" then .[] else . end')
  [ $n -gt 0 ] || echo "verify: commands.verify is empty; nothing run"
  if [ $ok = 0 ]; then echo "# result: ok" >>"$log"; else echo "# result: failed" >>"$log"; fi
  return $ok
}
base_of() { jq -r '.workspace.base // empty' <<<"$1" | grep . || cfg '.branches.base // "main"'; }

cmd_review() {
  local feature=$1; shift
  local read_as="" sel="" sargs=()
  while [ $# -gt 0 ]; do case $1 in
    --read-as) read_as=$2; shift 2;; --selection) sel=$2; shift 2;;
    --catalog|--tier|--constraint|--ref|--skill) sargs+=("$1" "$2"); shift 2;;
    --same-agent-ok) sargs+=("$1"); shift;;
    *) die "review: unknown $1";; esac; done
  [[ " ${sargs[*]-} " == *" --catalog "* ]] || die "review: --catalog required (routing.md: Reviewer tier and an agent other than the Builder's)"
  local st b spec kind report verdict head base
  st=$(load_state "$feature"); b=$(last_of_role "$st" builder)
  [ -n "$b" ] || die "review: no dispatched builder Task in run.json"
  spec=$(jq -r --arg t "$b" '.tasks[$t].spec' <<<"$st")
  kind=$(spec_line "$spec" Measurement | jq -r .kind)
  [ "$kind" != fix ] || die "review: Builder Task $b is a fix; use team rereview"
  b=$(round_source "$feature" builder reviewer)
  report=$(round_report "$spec" builder); verdict=$(read_verdict "$report" implemented "$read_as" "review: build $b")
  head=$(git -C "$(jq -r .workspace.path <<<"$st")" rev-parse --short HEAD); base=$(base_of "$st")
  local work=(); while IFS= read -r l; do work+=("$l"); done < <(work_args "$spec")
  local alias; alias=$(printf '%s\n' "${sargs[@]}" | grep -A1 -x -- --catalog | tail -1)
  cmd_start "$feature" reviewer "${work[@]}" --selection "${sel:-Reviewer per routing.md: $alias}" --ref "$report" \
    --constraint "Review $base...$head (git diff $base...HEAD). Builder report: $report. Read-only: no edits, no commits." \
    "${sargs[@]}"
  processed "$feature" "$b" "$report" "$verdict" "review"
}

cmd_accept() {
  local feature=$1; shift
  local read_as=""
  while [ $# -gt 0 ]; do case $1 in --read-as) read_as=$2; shift 2;; *) die "accept: unknown $1";; esac; done
  local st rv spec report verdict fdir
  rv=$(round_source "$feature" reviewer builder); st=$(load_state "$feature"); fdir=$(feature_dir "$feature")
  spec=$(jq -r --arg t "$rv" '.tasks[$t].spec' <<<"$st")
  report=$(round_report "$spec" reviewer); verdict=$(read_verdict "$report" pass "$read_as" "accept: review $rv")
  run_verify "$(jq -r .workspace.path <<<"$st")" "$fdir/logs/accept-verify.log" \
    || die "accept: verify failed at $(git -C "$(jq -r .workspace.path <<<"$st")" rev-parse --short HEAD); not at Gate 2"
  processed "$feature" "$rv" "$report" "$verdict" "Gate 2 (PO)"
  perl -i -pe 's/^- Stage: .*/- Stage: Gate 2 pending (board in-review)./' "$fdir/handoff.md"
  cmd_board "$feature" in-review
}

cmd_fix() {
  local feature=$1; shift
  local cause=defect round="" sel="" read_as="" extra=()
  while [ $# -gt 0 ]; do case $1 in
    --cause) cause=$2; shift 2;; --round) round=$2; shift 2;; --selection) sel=$2; shift 2;;
    --read-as) read_as=$2; shift 2;;
    --constraint|--ref|--skill) extra+=("$1" "$2"); shift 2;;
    *) die "fix: unknown $1";; esac; done
  local st rv spec report verdict n
  rv=$(round_source "$feature" reviewer builder); st=$(load_state "$feature")
  spec=$(jq -r --arg t "$rv" '.tasks[$t].spec' <<<"$st")
  report=$(round_report "$spec" reviewer); verdict=$(read_verdict "$report" "changes requested" "$read_as" "fix: review $rv")
  n=$(( $(spec_round "$spec") + 1 ))
  if [ -n "$round" ]; then n=$round
  elif [ $n -gt 2 ]; then die "fix: round $n would follow two failed fix rounds; ask the PO (review.md). After approval: team fix --round $n"; fi
  local work=(); while IFS= read -r l; do work+=("$l"); done < <(work_args "$spec")
  cmd_start "$feature" builder --kind fix --round "$n" --cause "$cause" --reuse builder "${work[@]}" \
    --selection "${sel:-same Builder, fix round $n}" --ref "$report" \
    --constraint "Fix round $n: answer every Must fix in $report (reproduce and fix, or reject with evidence); amend into the commits they correct." \
    ${extra[@]+"${extra[@]}"}
  processed "$feature" "$rv" "$report" "$verdict" "fix r$n"
}

prior_findings() { # review report -> "P1 Must fix, S1 Should fix"
  grep -oE '^([-*][[:space:]]*)?(\*\*)?[SP][0-9]+(\*\*)?[^A-Za-z]*(Must fix|Should fix)' "$1" 2>/dev/null \
    | sed -E 's/^([-*][[:space:]]*)?(\*\*)?([SP][0-9]+).*(Must fix|Should fix)$/\3 \4/' | paste -sd, - | sed 's/,/, /g' || true
}
fix_range() { # workspace reviewed-sha base -> how to see the fix
  local ws=$1 r=$2 base=$3
  if [ -z "$r" ] || ! git -C "$ws" cat-file -e "$r^{commit}" 2>/dev/null; then echo "reviewed revision unknown; review $base...HEAD"
  elif git -C "$ws" merge-base --is-ancestor "$r" HEAD; then echo "git diff ${r:0:9}..HEAD"
  else echo "history rewritten, git range-diff $base..${r:0:9} $base..HEAD"; fi
}
cmd_rereview() {
  local feature=$1; shift
  local sel="" read_as="" extra=()
  while [ $# -gt 0 ]; do case $1 in
    --selection) sel=$2; shift 2;; --read-as) read_as=$2; shift 2;; --constraint|--ref|--skill) extra+=("$1" "$2"); shift 2;;
    *) die "rereview: unknown $1";; esac; done
  local st b spec kind report verdict n prior head
  st=$(load_state "$feature"); b=$(last_of_role "$st" builder)
  [ -n "$b" ] || die "rereview: no dispatched builder Task in run.json"
  spec=$(jq -r --arg t "$b" '.tasks[$t].spec' <<<"$st")
  kind=$(spec_line "$spec" Measurement | jq -r .kind)
  [ "$kind" = fix ] || die "rereview: Builder Task $b is $kind, not a fix; a first review is team start reviewer"
  b=$(round_source "$feature" builder reviewer)
  report=$(round_report "$spec" builder); verdict=$(read_verdict "$report" implemented "$read_as" "rereview: fix $b")
  n=$(spec_round "$spec")
  prior=$(report_of "$(jq -r --arg t "$(last_of_role "$st" reviewer)" '.tasks[$t].spec' <<<"$st")")
  local ws ids range; ws=$(jq -r .workspace.path <<<"$st"); head=$(git -C "$ws" rev-parse --short HEAD)
  ids=$(prior_findings "$prior"); range=$(fix_range "$ws" "$(spec_line "$prior" Revision | cut -d' ' -f1)" "$(base_of "$st")")
  local work=(); while IFS= read -r l; do work+=("$l"); done < <(work_args "$spec")
  cmd_start "$feature" reviewer --kind re-review --round "$n" --reuse reviewer "${work[@]}" \
    --selection "${sel:-same Reviewer, scoped re-review round $n}" --ref "$prior" --ref "$report" \
    --constraint "Scoped re-review round $n at $head. Prior findings: ${ids:-none listed}; mark each resolved or not with file:line. Fix delta: $range. New findings only for problems the fix introduced; run team verify --reuse first." \
    ${extra[@]+"${extra[@]}"}
  processed "$feature" "$b" "$report" "$verdict" "re-review r$n"
}

report_verdict() { # report path -> first non-empty line under "## Result"; "-" when not written yet
  report_written "$1" || { echo "-"; return; }
  local v; v=$(awk '/^## Result/{f=1;next} f&&/^## /{exit} f&&NF{print;exit}' "$1" | cut -c1-120)
  echo "${v:-?}"
}

task_verdict() { # report status -> verdict; "missing" once the Task finished without a report
  local v; v=$(report_verdict "$1")
  if [ "$v" = - ] && { [ "$2" = completed ] || [ "$2" = failed ]; }; then echo missing; else echo "$v"; fi
}
cmd_status() {
  local feature=$1; shift
  local json=0; [ "${1:-}" = --json ] && json=1
  local st run tasks; st=$(load_state "$feature"); run=$(jq -r .run <<<"$st")
  tasks=$(orca_call orchestration task-list --run "$run" | jq -c '.tasks // []')
  local rows="[]" t id status title spec report d
  while IFS= read -r t; do
    id=$(jq -r .id <<<"$t"); status=$(jq -r .status <<<"$t"); title=$(jq -r .title <<<"$t")
    spec=$(jq -r --arg i "$id" '.tasks[$i].spec // empty' <<<"$st")
    d=$(jq -r --arg i "$id" '.tasks[$i].dispatches[-1].id // "-"' <<<"$st")
    report=""; [ -n "$spec" ] && report=$(spec_line "$spec" Output | sed -E 's/[; (].*//')
    rows=$(jq -c --arg i "$id" --arg s "$status" --arg ti "$title" --arg d "$d" --arg r "$report" \
      --arg v "$(task_verdict "$report" "$status")" '. + [{task:$i, status:$s, title:$ti, dispatch:$d, report:$r, verdict:$v}]' <<<"$rows")
  done < <(jq -c '.[]' <<<"$tasks")
  local fdir hand warns=() r; fdir=$(feature_dir "$feature"); hand="$fdir/handoff.md"
  while IFS= read -r r; do
    [ -n "$r" ] && report_written "$r" || continue
    grep -qF "| ${r#"$fdir"/} |" "$hand" 2>/dev/null || warns+=("not processed: ${r#"$fdir"/} (next round command, or record it in handoff.md)")
  done < <(jq -r '.[] | select(.status=="completed" or .status=="failed") | .report' <<<"$rows")
  [ ! -f "$hand" ] || [ "$(wc -l <"$hand")" -le 40 ] || warns+=("handoff.md has $(wc -l <"$hand" | tr -d ' ') lines; keep it under 40 (start.md \"Handoff\")")
  if [ $json = 1 ]; then
    jq --arg r "$run" --arg f "$feature" --args '{feature:$f, run:$r, tasks:., warnings:$ARGS.positional}' ${warns[@]+"${warns[@]}"} <<<"$rows"; return
  fi
  echo "$feature  Run $run  $(jq -r '.workspace.path + " (" + .workspace.branch + ")"' <<<"$st")"
  jq -r '.[] | [.task, .status, .dispatch, .title, (.report | split("/") | .[-1] // "-"), .verdict] | @tsv' <<<"$rows" \
    | column -t -s $'\t'
  [ ${#warns[@]} = 0 ] || printf 'warn: %s\n' "${warns[@]}"
}

cmd_board() {
  local feature=$1 status=${2:-}; [ -n "$status" ] || die "board: <status> required"
  local st; st=$(load_state "$feature")
  orca_call worktree set --worktree "$(jq -r .workspace.selector <<<"$st")" --workspace-status "$status" >/dev/null
  echo "board: $status"
}

cmd_read() {
  local feature=$1 ref=${2:-}; [ -n "$ref" ] || die "read: <task-id|role> required"; shift 2
  local last=5
  while [ $# -gt 0 ]; do case $1 in --last) last=$2; shift 2;; *) die "read: unknown $1";; esac; done
  local st task d; st=$(load_state "$feature")
  if [[ "$ref" =~ ^($ROLES)$ ]]; then task=$(last_of_role "$st" "$ref"); else task=$ref; fi
  d=$(jq -r --arg t "$task" '.tasks[$t].dispatches[-1].id // empty' <<<"$st")
  [ -n "$d" ] || die "read: no Dispatch recorded for $ref"
  # worker-read pages from the start of the transcript; follow the cursor to reach the tail.
  local msgs="[]" page cursor="" pages=0
  while :; do
    page=$(orca_call orchestration worker-read --dispatch "$d" ${cursor:+--cursor "$cursor"})
    msgs=$(jq -c --argjson m "$msgs" '$m + (.transcript.messages // [])' <<<"$page")
    cursor=$(jq -r '.transcript.nextCursor // empty' <<<"$page"); pages=$((pages + 1))
    [ -n "$cursor" ] && [ $pages -lt 50 ] || break
  done
  echo "$task  $d"
  jq -r --argjson n "$last" 'map({role, text: ([.blocks[]? | select(.type == "text") | .text] | join("\n"))} | select(.text != ""))
    | .[-$n:][] | "--- \(.role)\n\(.text[0:1200])"' <<<"$msgs"
}

cmd_close() {
  set -e
  local feature=$1; shift
  local remove=0 delbranch=0 merge=0
  while [ $# -gt 0 ]; do case $1 in
    --merge) merge=1; shift;; --remove-worktree) remove=1; shift;; --delete-branch) delbranch=1; shift;;
    *) die "close: unknown $1";; esac; done
  [ $delbranch = 0 ] || [ $remove = 1 ] || die "close: --delete-branch needs --remove-worktree"
  local st wpath main; st=$(load_state "$feature")
  wpath=$(jq -r .workspace.path <<<"$st"); main=$(jq -r .main <<<"$st")
  if [ $remove = 1 ]; then # refuse before anything changes
    [ "$(real "$wpath")" != "$(real "$main")" ] || die "close: the workspace is the main checkout (init --here); nothing to remove"
    case "$(real "$PWD")/" in "$(real "$wpath")"/*) die "close: run from outside $wpath to remove it";; esac
    exclude_links "$wpath"
    local dirty; dirty=$(git -C "$wpath" status --porcelain 2>/dev/null | head -5 | paste -sd, -)
    [ -z "$dirty" ] || die "close: $wpath has uncommitted changes ($dirty); commit or ask the PO first"
  fi
  if [ $merge = 1 ]; then
    local base wbranch cur; base=$(base_of "$st"); wbranch=$(jq -r .workspace.branch <<<"$st")
    [ "$(real "$wpath")" != "$(real "$main")" ] || die "close --merge: the workspace is the main checkout (init --here); merge it yourself"
    cur=$(git -C "$main" symbolic-ref --short HEAD 2>/dev/null || echo detached)
    [ "$cur" = "$base" ] || die "close --merge: $main is on $cur, not $base"
    [ -z "$(git -C "$main" status --porcelain --untracked-files=no)" ] || die "close --merge: $main has uncommitted changes"
    [ -z "$(git -C "$wpath" status --porcelain 2>/dev/null)" ] || die "close --merge: $wpath has uncommitted changes"
    if git -C "$main" merge-base --is-ancestor "$wbranch" "$base"; then echo "merge: $wbranch already in $base"
    else
      git -C "$main" merge --no-ff --no-edit -q "$wbranch" >&2 \
        || { git -C "$main" merge --abort 2>/dev/null || true; die "close --merge: conflict merging $wbranch into $base; merge aborted, nothing closed"; }
      echo "merge: $(git -C "$main" log -1 --format='%h %s')"
    fi
    run_verify "$main" "$(feature_dir "$feature")/logs/close-verify.log" \
      || die "close --merge: verify failed on $base after the merge commit; nothing closed. Fix forward, or undo with git -C $main reset --hard ORIG_HEAD (PO call)."
  fi
  local d res
  for d in $(jq -r '[.tasks[].dispatches[].id] | unique | .[]' <<<"$st"); do
    res=$(orca_call orchestration worker-release --dispatch "$d")
    echo "release $d: $(jq -r '.status // .state // .result // "ok"' <<<"$res" 2>/dev/null || echo ok)"
  done
  if "$ORCA" worktree set --worktree "$(jq -r .workspace.selector <<<"$st")" --workspace-status completed \
    --environment "$ORCA_ENV" --json >/dev/null 2>&1; then echo "board: completed"
  else echo "team: could not set board status (non-fatal)" >&2; fi
  if [ $remove = 1 ]; then
    local args=(worktree rm --worktree "path:$wpath"); [ $delbranch = 1 ] && args+=(--delete-branch)
    orca_call "${args[@]}" >/dev/null
    echo "removed $wpath$([ $delbranch = 1 ] && echo " and its branch")"
  fi
  save_state "$feature" "$(jq --arg c "$(date -u +%FT%TZ)" --argjson r $remove --argjson m $merge \
    '.closed = {at:$c, merged:($m == 1), worktreeRemoved:($r == 1)}' <<<"$st")"
}

need jq; need git
cmd=${1:-help}; shift || true
case $cmd in help|-h|--help) usage; exit 0;; whoami) need jq; whoami_json; exit 0;; agents) need node; cmd_agents "$@"; exit;; submit) need jq; cmd_submit "$@"; exit;; esac
git rev-parse --git-dir >/dev/null 2>&1 || die "not inside a git repo"
need node; load_cfg
case $cmd in
  init) cmd_init "$@";;
  solo) cmd_solo "$@";;
  spec|task|dispatch|start|review|fix|rereview|accept|status|board|read|close|verify|retry|pr-preflight)
    if [ -n "${1:-}" ] && [ -f "$(state_file "$1")" ]; then feature=$1; shift; else feature=$(infer_feature); fi
    "cmd_${cmd//-/_}" "$feature" "$@";;
  *) usage >&2; exit 2;;
esac
